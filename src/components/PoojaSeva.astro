---
import { poojas, siteConfig } from '../data/content.js';
import { Fragment } from 'astro/jsx-runtime';

const poojaIcons = {
  flower: '<path d="M12 22c4.97 0 9-4.03 9-9-4.97 0-9 4.03-9 9zM12 22c-4.97 0-9-4.03-9-9 4.97 0 9 4.03 9 9zM12 2c4.97 0 9 4.03 9 9 0-4.97-4.03-9-9-9zM12 2C7.03 2 3 6.03 3 11c0 4.97 4.03 9 9 9"/>',
  oil: '<path d="M8 2h8l-1 9h6l-7 11 3-9H7z"/>',
  prasad: '<path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>',
  bell: '<path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/><path d="M12 2v1"/>',
  book: '<path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/>',
};
---

<section class="section pooja-section" id="pooja">
  <div class="container">
    <div class="section-header">
      <span class="section-label">Pooja & Seva</span>
      <h2 class="heading-display heading-lg section-title">Sacred rituals for your blessings</h2>
      <p class="section-subtitle">
        Perform traditional poojas and sevas at Mahakaleshwar Temple. Our team helps arrange
        everything — from pandit ji to prasad distribution — so you focus on devotion.
      </p>
    </div>

    <div class="pooja-grid stagger-children">
      {poojas.map(p => (
        <article class="pooja-card">
          <div class="pooja-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <Fragment set:html={poojaIcons[p.icon] || ''} />
            </svg>
          </div>
          <div class="pooja-card-body">
            <h3 class="pooja-card-title">{p.name}</h3>
            <p class="pooja-card-desc">{p.desc}</p>
            {p.duration && (
              <div class="pooja-card-meta">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                Duration: {p.duration}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>

    <div class="pooja-cta">
      <p>Want to book a specific pooja or special seva?</p>
      <a href={`https://wa.me/${siteConfig.whatsapp}?text=Hi,%20I%20would%20like%20to%20book%20a%20pooja`} class="btn btn-whatsapp" target="_blank" rel="noopener">
        Book Pooja on WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .pooja-section {
    background: linear-gradient(180deg, var(--color-white) 0%, var(--color-sand-50) 100%);
  }

  .pooja-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 480px) {
    .pooja-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .pooja-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5);
    }
  }

  .pooja-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background: var(--color-white);
    border: 1px solid var(--color-sand-100);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    transition: all 0.25s ease;
  }

  .pooja-card:hover {
    border-color: var(--color-gold);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(26, 16, 8, 0.08);
  }

  .pooja-card-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .pooja-card-icon svg {
    width: 22px;
    height: 22px;
  }

  .pooja-card-title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-sand-900);
    margin-bottom: var(--space-1);
  }

  .pooja-card-desc {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-sand-700);
  }

  .pooja-card-meta {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: var(--space-2);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .pooja-card-meta svg {
    flex-shrink: 0;
    color: var(--color-gold);
  }

  .pooja-cta {
    background: var(--color-sand-900);
    color: var(--color-white);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  @media (min-width: 640px) {
    .pooja-cta {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .pooja-cta p {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-white);
  }
</style>
