---
import { features } from '../data/content.js';
---

<section class="features" aria-labelledby="features-heading">
  <div class="container">
    <h2 id="features-heading" class="section-title">Why Pilgrims Choose Us</h2>
    <p class="section-subtitle">Every detail designed for your spiritual journey</p>
    <div class="features-grid" role="list">
      {features.map(f => (
        <div class="feature-card" role="listitem">
          <div class="feature-icon" aria-hidden="true">{f.icon}</div>
          <h3 class="feature-title">{f.title}</h3>
          <p class="feature-desc">{f.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features { padding: var(--sp-section) 0; background: var(--c-cream); }
  .section-title {
    font-family: var(--font-dev);
    font-size: clamp(1.5rem, 4vw, 2rem);
    color: var(--c-maroon);
    text-align: center;
    margin-bottom: 8px;
  }
  .section-subtitle {
    text-align: center;
    color: #666;
    font-size: 15px;
    margin-bottom: 32px;
  }
  .features-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  .feature-card {
    background: #fff;
    padding: 22px 20px;
    border-radius: 14px;
    border: 1px solid rgba(107,16,16,0.07);
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .feature-card:hover {
    box-shadow: 0 6px 20px rgba(107,16,16,0.08);
    transform: translateY(-2px);
  }
  .feature-icon { font-size: 32px; margin-bottom: 12px; }
  .feature-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--c-maroon);
    margin-bottom: 6px;
  }
  .feature-desc { font-size: 13.5px; color: #555; line-height: 1.55; }

  @media (min-width: 520px) {
    .features-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 900px) {
    .features-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
