---
import { faqs, siteConfig } from '../data/content.js';
---

<section class="faq" aria-labelledby="faq-heading">
  <div class="container">
    <h2 id="faq-heading" class="section-title">Frequently Asked Questions</h2>
    <p class="section-subtitle">Quick answers to common questions about your stay</p>
    <div class="faq-list" role="list">
      {faqs.map((f, i) => (
        <details class="faq-item" role="listitem">
          <summary class="faq-question">{f.question}</summary>
          <div class="faq-answer"><p>{f.answer}</p></div>
        </details>
      ))}
    </div>
    <div class="faq-cta">
      <p>Still have questions?</p>
      <a href={`https://wa.me/${siteConfig.whatsapp}`} target="_blank" rel="noopener" class="faq-chat-btn">
        💬 Chat with us on WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .faq { padding: var(--sp-section) 0; background: var(--c-cream); }
  .faq-list { display: flex; flex-direction: column; gap: 10px; max-width: 760px; margin: 0 auto; }
  .faq-item {
    background: #fff;
    border: 1px solid rgba(0,0,0,0.06);
    border-radius: 12px;
    overflow: hidden;
  }
  .faq-question {
    padding: 16px 18px;
    font-size: 15px;
    font-weight: 600;
    color: var(--c-maroon);
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
    transition: background 0.15s;
  }
  .faq-question::-webkit-details-marker { display: none; }
  .faq-question::after {
    content: '+';
    font-size: 22px;
    font-weight: 400;
    color: var(--c-gold);
    transition: transform 0.2s;
  }
  details[open] .faq-question::after { transform: rotate(45deg); }
  .faq-question:hover { background: #fdf6ec; }
  .faq-answer {
    padding: 0 18px 16px;
    font-size: 14px;
    color: #555;
    line-height: 1.6;
  }
  .faq-cta {
    text-align: center;
    margin-top: 28px;
    padding: 20px;
  }
  .faq-cta p { font-size: 15px; color: #666; margin-bottom: 10px; }
  .faq-chat-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background: #25D366;
    color: #fff;
    border-radius: 10px;
    font-weight: 600;
    font-size: 14px;
    transition: opacity 0.2s;
  }
  .faq-chat-btn:hover { opacity: 0.9; }
</style>
