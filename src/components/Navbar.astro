---
// Navbar.astro — Sticky header
import { siteConfig } from '../data/content.js';
import NavMobile from './NavMobile.astro';
---

<header class="navbar" id="navbar">
  <div class="container nav-container">
    <a href="/" class="nav-logo" aria-label="{siteConfig.name} Home">
      <span class="nav-logo-icon" aria-hidden="true">🕉️</span>
      <div class="nav-logo-text">
        <strong>Mahakal</strong> Bhakta Nivas
      </div>
    </a>
    <nav class="nav-links" aria-label="Primary navigation">
      <a href="#rooms">Rooms</a>
      <a href="#gallery">Gallery</a>
      <a href="#why-us">Why Us</a>
      <a href="#nearby">Nearby</a>
      <a href="#how-to-reach">Reach</a>
      <a href="#poojas">Pooja</a>
      <a href="#testimonials">Reviews</a>
      <a href="#faq">FAQ</a>
      <a href="#booking" class="nav-cta-link">Book Now</a>
    </nav>
    <div class="nav-actions">
      <a href={`https://wa.me/${siteConfig.whatsapp}`} class="btn btn-whatsapp btn-sm nav-whatsapp" target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Book
      </a>
      <NavMobile />
    </div>
  </div>
</header>

<script>
  window.addEventListener('scroll', () => {
    document.getElementById('navbar')?.classList.toggle('navbar-shrink', window.scrollY > 50);
  });
</script>

<style>
  /* Navbar */
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(28, 25, 23, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    transition: all 0.3s ease;
    height: 64px;
  }

  .navbar.navbar-shrink {
    height: 52px;
  }

  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: 1rem;
  }

  .nav-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #fff;
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav-logo-icon { font-size: 1.5rem; }

  .nav-logo-text {
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.15;
    color: #fff;
  }

  .nav-logo-text strong {
    display: block;
    font-size: 1rem;
    color: var(--color-primary-light);
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: 1.25rem;
  }

  @media (min-width: 900px) {
    .nav-links { display: flex; }
  }

  .nav-links a {
    color: rgba(255,255,255,0.8);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s;
    white-space: nowrap;
  }

  .nav-links a:hover { color: var(--color-primary-light); }

  .nav-cta-link {
    background: var(--color-primary);
    color: #fff !important;
    padding: 0.4em 1em;
    border-radius: var(--radius-sm);
    font-weight: 600 !important;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-whatsapp { display: none; }

  @media (min-width: 640px) {
    .nav-whatsapp { display: inline-flex; }
  }
</style>
