---
import { siteConfig } from '../data/content.js';
---

<nav class="nav-mobile" aria-label="Mobile navigation">
  <a href="/rooms" class="mobile-nav-link">Rooms</a>
  <a href="/amenities" class="mobile-nav-link">Amenities</a>
  <a href="/pooja-seva" class="mobile-nav-link">Pooja & Seva</a>
  <a href="/gallery" class="mobile-nav-link">Gallery</a>
  <a href="/about" class="mobile-nav-link">About</a>
  <a href="/contact" class="mobile-nav-link">Contact</a>
  <div class="mobile-nav-actions">
    <a href={`tel:${siteConfig.phone.replace(/\s/g, '')}`} class="mobile-call-btn">📞 {siteConfig.phone}</a>
    <a href={`https://wa.me/${siteConfig.whatsapp}`} target="_blank" rel="noopener" class="mobile-whatsapp-btn">💬 Chat on WhatsApp</a>
  </div>
</nav>

<style>
  .nav-mobile {
    display: none;
    position: fixed;
    inset: 64px 0 auto 0;
    background: #fff;
    flex-direction: column;
    padding: 16px;
    gap: 4px;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    z-index: 999;
  }
  .nav-mobile.active { display: flex; }
  .mobile-nav-link {
    display: block;
    padding: 14px 16px;
    font-size: 16px;
    font-weight: 500;
    color: #333;
    border-radius: 8px;
    transition: background 0.15s;
  }
  .mobile-nav-link:hover { background: #FFF9EC; color: var(--c-maroon); }
  .mobile-nav-actions {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 12px;
    border-top: 1px solid #eee;
  }
  .mobile-call-btn, .mobile-whatsapp-btn {
    display: block;
    text-align: center;
    padding: 14px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 15px;
  }
  .mobile-call-btn {
    background: var(--c-white);
    color: var(--c-maroon);
    border: 1.5px solid var(--c-maroon);
  }
  .mobile-whatsapp-btn {
    background: #25D366;
    color: #fff;
  }
</style>
