---
// Story.astro — "Our Story" section with founder narrative
import { siteConfig } from '../data/content.js';
---

<section class="story-section" id="story">
  <div class="container">
    <div class="story-grid">
      <!-- Visual -->
      <div class="story-visual">
        <img
          src="/story.png"
          alt={`${siteConfig.shortName} - Family serving devotees since ${siteConfig.foundedYear}`}
          loading="lazy"
          width="800"
          height="600"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        />
        <div class="story-visual-fallback">
          <div class="story-visual-quote">
            "Atithi Devo Bhava — the guest is divine."
          </div>
          <div class="story-visual-since">
            — Serving devotees since {siteConfig.foundedYear}
          </div>
        </div>
      </div>

      <!-- Content -->
      <div class="story-content">
        <span class="section-tag">Our Story</span>
        <h2 class="section-title">A Family Tradition of Seva</h2>

        <div class="story-text">
          <p class="story-lead">
            Since {siteConfig.foundedYear}, our family has been welcoming pilgrims to Ujjain
            with the warmth and devotion that only a family-run dharmashala can offer.
          </p>
          <p>
            What began as a small 10-room facility near the sacred Mahakaleshwar Temple has
            grown into one of Ujjain's most trusted dharmashalas — but our values remain unchanged.
            Every guest who walks through our doors is treated as family.
          </p>
          <p>
            Our team knows every corner of Ujjain, every temple ritual, every festival tradition.
            From arranging Bhasma Aarti tickets to helping you find a pandit, from guiding you
            to the temple at 4 AM to making sure your family feels at home — we are here for you,
            always.
          </p>
        </div>

        <div class="story-stats">
          <div class="story-stat">
            <div class="story-stat-value">{new Date().getFullYear() - siteConfig.foundedYear}+</div>
            <div class="story-stat-label">Years of Service</div>
          </div>
          <div class="story-stat">
            <div class="story-stat-value">50,000+</div>
            <div class="story-stat-label">Devotees Hosted</div>
          </div>
          <div class="story-stat">
            <div class="story-stat-value">4.8 ★</div>
            <div class="story-stat-label">Google Rating</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .story-section {
    padding-block: var(--section-padding);
    background: linear-gradient(180deg, var(--color-gray-50) 0%, var(--color-white) 100%);
  }

  .story-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 769px) {
    .story-grid {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  .story-visual {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
  }

  .story-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story-visual-fallback {
    display: none;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-dark) 0%, var(--color-dark-secondary) 100%);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    text-align: center;
    color: var(--color-white);
    position: relative;
    overflow: hidden;
  }

  .story-visual-fallback::before {
    content: '🕉️';
    position: absolute;
    font-size: 15rem;
    opacity: 0.06;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    line-height: 1;
  }

  .story-visual-quote {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 700;
    font-style: italic;
    line-height: 1.4;
    position: relative;
    z-index: 1;
  }

  .story-visual-since {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--color-primary-light);
    letter-spacing: 0.05em;
    position: relative;
    z-index: 1;
  }

  .story-content {
    padding: 0;
  }

  .story-text {
    margin: 1.25rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .story-lead {
    font-size: 1.0625rem;
    color: var(--color-dark);
    font-weight: 500;
  }

  .story-text p {
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--color-gray-700);
  }

  .story-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-gray-200);
  }

  .story-stat-value {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 700;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-gold) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .story-stat-label {
    font-size: 0.8rem;
    color: var(--color-gray-500);
    margin-top: 0.25rem;
  }
</style>
