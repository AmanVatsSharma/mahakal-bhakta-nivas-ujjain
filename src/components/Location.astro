---
import { siteConfig } from '../data/content.js';
---

<section class="location" aria-labelledby="location-heading">
  <div class="container">
    <h2 id="location-heading" class="section-title">How to Reach</h2>
    <p class="section-subtitle">Located in the heart of Ujjain, steps from Mahakaleshwar Temple</p>
    <div class="location-grid">
      <div class="map-wrap">
        <iframe
          title="Mahakal Bhakta Nivas location map"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3679.5!2d75.7685!3d23.1765!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMjPCsDExJzM3LjQiTiA3NcKwNTYnMjguMyJF!5e0!3m2!1sen!2sin!4v1700000000000"
          allowFullScreen=""
          loading="lazy"
          referrerPolicy="no-referrer-when-downgrade"
          aria-label="Map showing location of Mahakal Bhakta Nivas near Mahakaleshwar Temple Ujjain"
        ></iframe>
      </div>
      <div class="location-details">
        <div class="loc-card">
          <h3>Address</h3>
          <p>{siteConfig.address}</p>
        </div>
        <div class="loc-card">
          <h3>From Railway Station</h3>
          <p>Ujjain Junction — 3 km • Auto/Taxi: 10 mins</p>
        </div>
        <div class="loc-card">
          <h3>From Airport</h3>
          <p>Devi Ahilya Bai Holkar Airport, Indore — 58 km • Taxi: 1.5 hrs</p>
        </div>
        <div class="loc-actions">
          <a href={`https://maps.google.com/?q=Mahakaleshwar+Temple,Ujjain`} target="_blank" rel="noopener" class="btn btn-outline-dark">
            📍 Open in Google Maps
          </a>
          <a href="/contact" class="btn btn-primary-dark">Contact Us</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .location { padding: var(--sp-section) 0; background: var(--c-cream); }
  .location-grid { display: grid; gap: 20px; }
  .map-wrap {
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 4/3;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
  }
  .map-wrap iframe { width: 100%; height: 100%; border: 0; }
  .location-details { display: flex; flex-direction: column; gap: 12px; }
  .loc-card {
    background: #fff;
    padding: 16px 18px;
    border-radius: 12px;
    border: 1px solid rgba(0,0,0,0.05);
  }
  .loc-card h3 { font-size: 14px; color: var(--c-maroon); margin-bottom: 4px; }
  .loc-card p { font-size: 13.5px; color: #555; line-height: 1.5; }
  .loc-actions { display: flex; flex-direction: column; gap: 8px; margin-top: 4px; }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 20px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.2s;
    text-align: center;
  }
  .btn-outline-dark {
    background: #fff;
    color: var(--c-maroon);
    border: 1.5px solid var(--c-maroon);
  }
  .btn-outline-dark:hover { background: var(--c-maroon); color: #fff; }
  .btn-primary-dark { background: var(--c-maroon); color: #fff; }
  .btn-primary-dark:hover { background: #500d0d; }

  @media (min-width: 800px) {
    .location-grid { grid-template-columns: 1.2fr 1fr; }
  }
</style>
