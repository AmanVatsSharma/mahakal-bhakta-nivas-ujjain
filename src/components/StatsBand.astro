---
// StatsBand.astro — Trust signals band with key stats
import { siteConfig } from '../data/content.js';
---

<section class="stats-section" id="stats">
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item">
        <div class="stat-icon" aria-hidden="true">🕉️</div>
        <div class="stat-value">{new Date().getFullYear() - siteConfig.foundedYear}+</div>
        <div class="stat-label">Years of Seva</div>
      </div>
      <div class="stat-item">
        <div class="stat-icon" aria-hidden="true">🚶</div>
        <div class="stat-value">5 min</div>
        <div class="stat-label">Walk to Temple</div>
      </div>
      <div class="stat-item">
        <div class="stat-icon" aria-hidden="true">⭐</div>
        <div class="stat-value">4.8</div>
        <div class="stat-label">Google Rating</div>
      </div>
      <div class="stat-item">
        <div class="stat-icon" aria-hidden="true">👨‍👩‍👧‍👦</div>
        <div class="stat-value">50,000+</div>
        <div class="stat-label">Happy Guests</div>
      </div>
    </div>
  </div>
</section>

<style>
  .stats-section {
    background: linear-gradient(135deg, var(--color-dark) 0%, var(--color-dark-secondary) 100%);
    padding-block: clamp(2rem, 4vw, 3rem);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  @media (min-width: 520px) {
    .stats-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat-item {
    text-align: center;
    color: var(--color-white);
  }

  .stat-icon {
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
    display: block;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 800;
    color: var(--color-primary-light);
    line-height: 1;
  }

  .stat-label {
    font-size: clamp(0.75rem, 2vw, 0.85rem);
    color: rgba(255, 255, 255, 0.7);
    margin-top: 0.5rem;
    font-weight: 500;
  }
</style>
