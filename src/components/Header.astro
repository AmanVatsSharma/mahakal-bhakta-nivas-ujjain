---
import { CONTACT } from '../config';

const waNumber = CONTACT.whatsapp.replace(/\D/g, '');
const waLink = `https://wa.me/${waNumber}?text=${encodeURIComponent('Namaste! I would like to book a room at Mahakal Bhakta Nivas, Ujjain.')}`;
const telLink = `tel:${CONTACT.phone.replace(/[^+\d]/g, '')}`;

const NAV = [
	{ label: 'Home', href: '/' },
	{ label: 'Rooms', href: '/rooms/' },
	{ label: 'Amenities', href: '/amenities/' },
	{ label: 'Gallery', href: '/gallery/' },
	{ label: 'Pooja & Seva', href: '/pooja-seva/' },
	{ label: 'Contact', href: '/contact/' },
];
---

<header class="site-header">
	<div class="container header-inner">
		<a href="/" class="logo" aria-label="Mahakal Bhakta Nivas — Home">
			<svg class="logo-icon" width="38" height="38" viewBox="0 0 32 32" fill="none" aria-hidden="true">
				<defs>
					<linearGradient id="trishul-gold" x1="0" y1="0" x2="1" y2="1">
						<stop offset="0" stop-color="#f59e0b" />
						<stop offset="1" stop-color="#b45309" />
					</linearGradient>
				</defs>
				<path d="M6 29V15a10 10 0 0 1 20 0v14" stroke="url(#trishul-gold)" stroke-width="2" stroke-linecap="round" />
				<path d="M16 8v18" stroke="url(#trishul-gold)" stroke-width="2" stroke-linecap="round" />
				<path d="M16 3l2.2 4h-4.4L16 3z" fill="url(#trishul-gold)" />
				<path d="M10.5 10c0 5.5 2.5 8 5.5 8s5.5-2.5 5.5-8" stroke="url(#trishul-gold)" stroke-width="2" stroke-linecap="round" />
				<path d="M10.5 6.5v4M21.5 6.5v4" stroke="url(#trishul-gold)" stroke-width="2" stroke-linecap="round" />
				<circle cx="16" cy="28.5" r="1.6" fill="url(#trishul-gold)" />
			</svg>
			<span class="logo-text">
				<span class="logo-title">Mahakal Bhakta Nivas</span>
				<span class="logo-subtitle">Ujjain &middot; Near Mahakaleshwar</span>
			</span>
		</a>

		<nav class="primary-nav" aria-label="Primary navigation">
			{NAV.map((item) => <a href={item.href}>{item.label}</a>)}
		</nav>

		<div class="header-actions">
			<a href={waLink} target="_blank" rel="noopener noreferrer" class="pill pill-whatsapp">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
				<span>WhatsApp</span>
			</a>
			<a href={telLink} class="pill pill-call">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
				<span>Call Now</span>
			</a>
			<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
				<span class="nav-toggle-bar"></span>
				<span class="nav-toggle-bar"></span>
				<span class="nav-toggle-bar"></span>
			</button>
		</div>
	</div>

	<div class="mobile-menu" id="mobile-menu" hidden>
		<nav class="mobile-nav" aria-label="Mobile navigation">
			{NAV.map((item) => <a href={item.href}>{item.label}</a>)}
		</nav>
		<div class="mobile-ctas">
			<a href={waLink} target="_blank" rel="noopener noreferrer" class="pill pill-whatsapp">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
				Book on WhatsApp
			</a>
			<a href={telLink} class="pill pill-call">
				<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
				Call {CONTACT.phoneDisplay}
			</a>
		</div>
	</div>
</header>

<script>
	const toggle = document.querySelector('.nav-toggle');
	const menu = document.getElementById('mobile-menu');

	toggle?.addEventListener('click', () => {
		const open = toggle.getAttribute('aria-expanded') === 'true';
		toggle.setAttribute('aria-expanded', String(!open));
		toggle.setAttribute('aria-label', !open ? 'Close menu' : 'Open menu');
		menu?.toggleAttribute('hidden', open);
	});

	menu?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => {
			toggle?.setAttribute('aria-expanded', 'false');
			menu?.setAttribute('hidden', '');
		});
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
			toggle.setAttribute('aria-expanded', 'false');
			menu?.setAttribute('hidden', '');
		}
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(255, 251, 245, 0.95);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid rgba(217, 119, 6, 0.18);
		box-shadow: 0 2px 10px rgba(120, 72, 12, 0.06);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 72px;
		gap: 1rem;
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		color: inherit;
		flex-shrink: 0;
	}

	.logo-icon {
		width: 38px;
		height: 38px;
		flex-shrink: 0;
	}

	.logo-text {
		display: flex;
		flex-direction: column;
		line-height: 1.15;
	}

	.logo-title {
		font-family: 'Playfair Display', Georgia, serif;
		font-weight: 700;
		font-size: 1.05rem;
		color: #1c1410;
		white-space: nowrap;
	}

	.logo-subtitle {
		font-size: 0.62rem;
		color: #b45309;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.primary-nav {
		display: flex;
		gap: 1.5rem;
		align-items: center;
	}

	.primary-nav a {
		color: #4b3c30;
		text-decoration: none;
		font-weight: 500;
		font-size: 0.9rem;
		transition: color 0.2s;
		position: relative;
		padding: 4px 0;
	}

	.primary-nav a:hover,
	.primary-nav a[aria-current='page'] {
		color: #b45309;
	}

	.primary-nav a::after {
		content: '';
		position: absolute;
		bottom: -2px;
		left: 0;
		width: 0;
		height: 2px;
		background: linear-gradient(90deg, #f59e0b, #b45309);
		border-radius: 2px;
		transition: width 0.3s ease;
	}

	.primary-nav a:hover::after,
	.primary-nav a[aria-current='page']::after {
		width: 100%;
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		flex-shrink: 0;
	}

	.pill {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.55rem 1rem;
		border-radius: 999px;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.85rem;
		transition: all 0.2s ease;
		white-space: nowrap;
	}

	.pill-whatsapp {
		background: #25d366;
		color: #fff;
		box-shadow: 0 2px 8px rgba(37, 211, 102, 0.35);
	}

	.pill-whatsapp:hover {
		background: #1fb855;
		transform: translateY(-1px);
		box-shadow: 0 4px 12px rgba(37, 211, 102, 0.45);
	}

	.pill-call {
		background: linear-gradient(135deg, #f59e0b, #d97706);
		color: #fff;
		box-shadow: 0 2px 8px rgba(217, 119, 6, 0.35);
	}

	.pill-call:hover {
		background: linear-gradient(135deg, #d97706, #b45309);
		transform: translateY(-1px);
		box-shadow: 0 4px 12px rgba(217, 119, 6, 0.45);
	}

	.nav-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 42px;
		height: 42px;
		padding: 0 9px;
		background: rgba(217, 119, 6, 0.1);
		border: 1px solid rgba(217, 119, 6, 0.25);
		border-radius: 10px;
		cursor: pointer;
	}

	.nav-toggle-bar {
		display: block;
		height: 2.5px;
		width: 100%;
		background: #b45309;
		border-radius: 2px;
		transition: transform 0.25s ease, opacity 0.25s ease;
	}

	.nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(1) {
		transform: translateY(7.5px) rotate(45deg);
	}

	.nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(2) {
		opacity: 0;
	}

	.nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(3) {
		transform: translateY(-7.5px) rotate(-45deg);
	}

	.mobile-menu {
		border-top: 1px solid rgba(217, 119, 6, 0.15);
		background: rgba(255, 251, 245, 0.98);
		backdrop-filter: blur(12px);
		padding: 1rem 1.25rem 1.5rem;
	}

	.mobile-nav {
		display: flex;
		flex-direction: column;
	}

	.mobile-nav a {
		padding: 0.8rem 0.25rem;
		color: #4b3c30;
		text-decoration: none;
		font-weight: 600;
		font-size: 1rem;
		border-bottom: 1px solid rgba(217, 119, 6, 0.12);
	}

	.mobile-nav a:hover {
		color: #b45309;
	}

	.mobile-ctas {
		display: flex;
		gap: 0.75rem;
		margin-top: 1.25rem;
	}

	.mobile-ctas .pill {
		flex: 1;
		justify-content: center;
		padding: 0.85rem 1rem;
	}

	@media (max-width: 1023px) {
		.primary-nav {
			display: none;
		}

		.nav-toggle {
			display: flex;
		}
	}

	@media (max-width: 480px) {
		.header-inner {
			height: 64px;
		}

		.logo-title {
			font-size: 0.92rem;
		}

		.logo-subtitle {
			font-size: 0.56rem;
		}

		.logo-icon {
			width: 32px;
			height: 32px;
		}

		.pill span {
			display: none;
		}

		.pill {
			padding: 0.55rem 0.7rem;
		}
	}

	@media (min-width: 1024px) {
		.mobile-menu {
			display: none;
		}
	}
</style>
