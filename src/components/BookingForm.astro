---
// BookingForm.astro — Inquiry form + side info card
import { siteConfig } from '../data/content.js';
---

<section class="section booking-section" id="booking">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Book Now</span>
      <h2 class="section-title">Reserve Your Room</h2>
      <p class="section-subtitle">Fill the form or WhatsApp us for instant availability.</p>
    </div>
    <div class="booking-grid">
      <!-- Form -->
      <form class="booking-form" name="booking-inquiry" netlify="true" netlify-honeypot="field">
        <input type="hidden" name="form-name" value="booking-inquiry" />
        <p class="form-hint" style="display:none;">
          <label>Don't fill this out: <input name="field" /></label>
        </p>
        <div class="form-row form-row-2">
          <div class="form-group">
            <label for="name">Full Name <span class="required">*</span></label>
            <input type="text" id="name" name="name" required placeholder="Your name" />
          </div>
          <div class="form-group">
            <label for="phone">Phone Number <span class="required">*</span></label>
            <input type="tel" id="phone" name="phone" required placeholder="+91 98765 43210" />
          </div>
        </div>
        <div class="form-row form-row-2">
          <div class="form-group">
            <label for="checkin">Check-in Date <span class="required">*</span></label>
            <input type="date" id="checkin" name="checkin" required />
          </div>
          <div class="form-group">
            <label for="checkout">Check-out Date <span class="required">*</span></label>
            <input type="date" id="checkout" name="checkout" required />
          </div>
        </div>
        <div class="form-row form-row-2">
          <div class="form-group">
            <label for="room-type">Room Type</label>
            <select id="room-type" name="room_type">
              <option value="">Select preference</option>
              <option value="non-ac">Non-AC Standard (₹600)</option>
              <option value="ac">AC Premium (₹1,200)</option>
              <option value="deluxe">Deluxe with AC (₹2,000)</option>
              <option value="family">3-Bed Family Suite (₹3,000)</option>
              <option value="dormitory">Dormitory (₹300/head)</option>
            </select>
          </div>
          <div class="form-group">
            <label for="guests">Number of Guests</label>
            <select id="guests" name="guests">
              <option value="1">1 Guest</option>
              <option value="2">2 Guests</option>
              <option value="3">3 Guests</option>
              <option value="4">4 Guests</option>
              <option value="5+">5+ Guests</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label for="message">Special Requests / Notes</label>
          <textarea id="message" name="message" placeholder="e.g. Need room near temple, early check-in for Bhasma Aarti..."></textarea>
        </div>
        <div class="form-submit-row">
          <button type="submit" class="btn btn-primary btn-lg">
            📨 Submit Enquiry
          </button>
          <span class="form-hint">Or WhatsApp us directly for instant response.</span>
        </div>
      </form>

      <!-- Side info -->
      <div class="booking-info">
        <div class="booking-info-card">
          <h3>Quick Info</h3>
          <ul>
            <li>📍 {siteConfig.streetAddress}, {siteConfig.city}</li>
            <li>📞 {siteConfig.phoneDisplay}</li>
            <li>📧 {siteConfig.email}</li>
            <li>🕐 24×7 Reception</li>
            <li>🚶 {siteConfig.distanceToTemple} walk to Mahakaleshwar Temple</li>
            <li>🍽️ Pure Veg Restaurant on-site</li>
            <li>🛌 Clean, sanitised rooms</li>
            <li>🅿️ Parking available</li>
          </ul>
          <div class="booking-info-divider">
            <span>or reach us on</span>
          </div>
          <a href={`https://wa.me/${siteConfig.whatsapp}`} class="btn btn-whatsapp" target="_blank" rel="noopener">
            💬 Chat on WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .booking-section {
    padding-block: var(--section-padding);
    background: linear-gradient(180deg, var(--color-gray-50), var(--color-white));
  }

  .booking-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .booking-grid {
      grid-template-columns: 1.5fr 1fr;
    }
  }

  .booking-form {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    border: 1px solid var(--color-gray-200);
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    gap: 1rem;
  }

  .form-row-2 {
    grid-template-columns: 1fr;
  }

  @media (min-width: 520px) {
    .form-row-2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .form-group label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-dark);
  }

  .required {
    color: #dc2626;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-gray-300);
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    background: var(--color-white);
    color: var(--color-dark);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    width: 100%;
    font-family: var(--font-body);
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(217, 119, 6, 0.15);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 80px;
  }

  .form-submit-row {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .form-hint {
    font-size: 0.8rem;
    color: var(--color-gray-500);
  }

  .booking-info {
    position: sticky;
    top: 80px;
  }

  .booking-info-card {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    border: 1px solid var(--color-gray-200);
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .booking-info-card h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-dark);
  }

  .booking-info-card ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .booking-info-card li {
    font-size: 0.9rem;
    color: var(--color-gray-700);
  }

  .booking-info-divider {
    text-align: center;
    position: relative;
  }

  .booking-info-divider::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--color-gray-200);
  }

  .booking-info-divider span {
    background: var(--color-white);
    padding: 0 0.75rem;
    position: relative;
    font-size: 0.8rem;
    color: var(--color-gray-500);
  }
</style>
