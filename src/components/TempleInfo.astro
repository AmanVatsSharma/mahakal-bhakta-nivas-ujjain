---
import { siteConfig } from '../data/content.js';

const darshanTypes = [
  {
    name: 'Bhasma Aarti',
    desc: 'The world-famous sacred ash ritual at 4:00 AM. Pre-booking required, limited seats. We help arrange passes.',
    icon: 'fire',
    note: 'Most sacred darshan',
  },
  {
    name: 'Mangala Aarti',
    desc: 'The first morning prayer at 4:00 AM. Free entry, peaceful atmosphere.',
    icon: 'sun',
  },
  {
    name: 'Morning Darshan',
    desc: 'Open from 5:00 AM to 12:00 PM. Best for relaxed visits without long queues.',
    icon: 'sunrise',
  },
  {
    name: 'Evening Darshan',
    desc: 'Open from 4:00 PM to 8:00 PM. Beautiful aarti experience at sunset.',
    icon: 'sunset',
  },
];

const iconMap = {
  fire: '<path d="M8.5 14.5A2.5 2.5 0 0111 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 11-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 012.5 2.5z"/>',
  sun: '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>',
  sunrise: '<path d="M17 18a5 5 0 00-10 0"/><line x1="12" y1="2" x2="12" y2="9"/><line x1="4.22" y1="10.22" x2="5.64" y2="11.64"/><line x1="1" y1="18" x2="3" y2="18"/><line x1="21" y1="18" x2="23" y2="18"/><line x1="18.36" y1="10.22" x2="19.78" y2="11.64"/><line x1="23" y1="22" x2="1" y2="22"/><polyline points="8 6 12 2 16 6"/>',
  sunset: '<path d="M17 18a5 5 0 00-10 0"/><line x1="12" y1="9" x2="12" y2="2"/><line x1="4.22" y1="10.22" x2="5.64" y2="11.64"/><line x1="1" y1="18" x2="3" y2="18"/><line x1="21" y1="18" x2="23" y2="18"/><line x1="18.36" y1="10.22" x2="19.78" y2="11.64"/><line x1="23" y1="22" x2="1" y2="22"/>',
};
---

<section class="section temple-info-section" id="temple-info">
  <div class="container">
    <div class="section-header">
      <span class="section-label">Temple & Darshan</span>
      <h2 class="heading-display heading-lg section-title">
        Mahakaleshwar Temple — A Jyotirlinga of Shiva
      </h2>
      <p class="section-subtitle">
        One of the twelve Jyotirlingas, Mahakaleshwar is the most sacred shrine in Ujjain.
        Plan your darshan with confidence — we help with timing, passes, and rituals.
      </p>
    </div>

    <div class="temple-info-grid stagger-children">
      {darshanTypes.map(d => (
        <article class="temple-info-card">
          <div class="temple-info-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <Fragment set:html={iconMap[d.icon]} />
            </svg>
          </div>
          <h3 class="temple-info-title">{d.name}</h3>
          <p class="temple-info-desc">{d.desc}</p>
          {d.note && (
            <span class="temple-info-note">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {d.note}
            </span>
          )}
        </article>
      ))}
    </div>

    <div class="temple-info-help">
      <div class="temple-info-help-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="M9 12l2 2 4-4"/>
        </svg>
      </div>
      <div>
        <h3 class="temple-info-help-title">Need help with Bhasma Aarti booking?</h3>
        <p class="temple-info-help-text">
          Our family has been assisting devotees for {siteConfig.yearsServing || '25+'} years.
          Ask us about online pass booking, group arrangements, and special sevas. Free guidance for all our guests.
        </p>
      </div>
      <a href={`https://wa.me/${siteConfig.whatsapp}?text=Hi,%20please%20help%20with%20Bhasma%20Aarti%20booking`} class="btn btn-whatsapp" target="_blank" rel="noopener">
        Get Help
      </a>
    </div>
  </div>
</section>

<style>
  .temple-info-section {
    background: linear-gradient(180deg, var(--color-sand-50) 0%, var(--color-white) 100%);
  }

  .temple-info-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 480px) {
    .temple-info-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .temple-info-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-5);
    }
  }

  .temple-info-card {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    border: 1px solid var(--color-sand-100);
    transition: all 0.25s ease;
    position: relative;
  }

  .temple-info-card:hover {
    border-color: var(--color-gold);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(26, 16, 8, 0.08);
  }

  .temple-info-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
  }

  .temple-info-icon svg {
    width: 24px;
    height: 24px;
  }

  .temple-info-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-sand-900);
    margin-bottom: var(--space-2);
  }

  .temple-info-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-sand-700);
  }

  .temple-info-note {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: var(--space-3);
    background: var(--color-gold);
    color: var(--color-sand-900);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .temple-info-note svg {
    flex-shrink: 0;
  }

  .temple-info-help {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    align-items: center;
    background: var(--color-sand-900);
    color: var(--color-white);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
  }

  @media (min-width: 768px) {
    .temple-info-help {
      grid-template-columns: auto 1fr auto;
      gap: var(--space-5);
      padding: var(--space-6) var(--space-7);
    }
  }

  .temple-info-help-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-gold);
    color: var(--color-sand-900);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .temple-info-help-icon svg {
    width: 28px;
    height: 28px;
  }

  .temple-info-help-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-white);
    margin-bottom: 0.25rem;
  }

  .temple-info-help-text {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
  }

  .temple-info-help .btn {
    flex-shrink: 0;
  }
</style>
