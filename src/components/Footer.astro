---
import { CONTACT, SITE, NAV_LINKS } from '../config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container">
		<div class="footer-grid">
			<div class="footer-col footer-brand">
				<div class="footer-logo">
					<span class="logo-icon">🕉️</span>
					<div>
						<strong>Mahakal Bhakta Nivas</strong>
						<span>Ujjain</span>
					</div>
				</div>
				<p class="footer-tagline">Your spiritual home in the holy city of Ujjain. Affordable, clean, and peaceful accommodation for devotees of Lord Mahakaleshwar.</p>
				<div class="footer-social">
					<a href={`https://wa.me/${CONTACT.whatsapp.replace(/\D/g, '')}`} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">💬</a>
					<a href={`tel:${CONTACT.phone}`} aria-label="Call">📞</a>
					<a href={`mailto:${CONTACT.email}`} aria-label="Email">✉️</a>
					<a href="#" aria-label="Facebook" target="_blank" rel="noopener noreferrer">f</a>
				</div>
			</div>

			<div class="footer-col">
				<h4>Quick Links</h4>
				<ul>
					{NAV_LINKS.map(link => (
						<li><a href={link.href}>{link.label}</a></li>
					))}
				</ul>
			</div>

			<div class="footer-col">
				<h4>Nearby Temples</h4>
				<ul>
					<li><a href="#">Mahakaleshwar Temple (1 km)</a></li>
					<li><a href="#">Kalbhairav Temple (2 km)</a></li>
					<li><a href="#">Ram Ghat (1.5 km)</a></li>
					<li><a href="#">Harsiddhi Temple (2.5 km)</a></li>
					<li><a href="#">Mangalnath Temple (6 km)</a></li>
					<li><a href="#">Sandipani Ashram (8 km)</a></li>
				</ul>
			</div>

			<div class="footer-col">
				<h4>Contact</h4>
				<ul class="contact-list">
					<li>
						<strong>Address:</strong>
						<span>{CONTACT.address}</span>
					</li>
					<li>
						<strong>Phone:</strong>
						<a href={`tel:${CONTACT.phone}`}>{CONTACT.phoneDisplay}</a>
					</li>
					<li>
						<strong>WhatsApp:</strong>
						<a href={`https://wa.me/${CONTACT.whatsapp.replace(/\D/g, '')}`} target="_blank" rel="noopener noreferrer">{CONTACT.whatsappDisplay}</a>
					</li>
					<li>
						<strong>Email:</strong>
						<a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
					</li>
				</ul>
			</div>
		</div>

		<div class="footer-bottom">
			<p>© {year} {SITE.name}. All rights reserved. | Built with devotion for Mahakal Bhaktas.</p>
			<div class="footer-bottom-links">
				<a href="#privacy">Privacy Policy</a>
				<a href="#terms">Terms</a>
				<a href="#sitemap">Sitemap</a>
			</div>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
		color: rgba(255, 255, 255, 0.85);
		padding: 4rem 1.5rem 1.5rem;
		margin-top: 0;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.5fr 1fr 1fr 1.3fr;
		gap: 3rem;
		margin-bottom: 3rem;
	}

	.footer-logo {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1rem;
		color: var(--color-white);
	}

	.logo-icon {
		font-size: 2.5rem;
	}

	.footer-logo strong {
		display: block;
		font-size: 1.2rem;
		font-weight: 700;
	}

	.footer-logo span {
		display: block;
		font-size: 0.85rem;
		opacity: 0.7;
	}

	.footer-tagline {
		font-size: 0.95rem;
		line-height: 1.6;
		opacity: 0.75;
		margin: 0 0 1.5rem;
	}

	.footer-social {
		display: flex;
		gap: 0.75rem;
	}

	.footer-social a {
		width: 40px;
		height: 40px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 255, 255, 0.1);
		border-radius: 50%;
		text-decoration: none;
		font-size: 1.1rem;
		transition: all 0.3s ease;
	}

	.footer-social a:hover {
		background: var(--color-primary);
		transform: translateY(-3px);
	}

	.footer-col h4 {
		color: var(--color-white);
		font-size: 1.05rem;
		margin: 0 0 1.25rem;
		font-weight: 600;
	}

	.footer-col ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.footer-col li {
		margin-bottom: 0.6rem;
		font-size: 0.9rem;
		opacity: 0.75;
		line-height: 1.5;
	}

	.footer-col a {
		color: rgba(255, 255, 255, 0.85);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.footer-col a:hover {
		color: var(--color-primary);
	}

	.contact-list li {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		margin-bottom: 0.85rem;
	}

	.contact-list strong {
		font-size: 0.75rem;
		opacity: 0.6;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.contact-list span,
	.contact-list a {
		font-size: 0.92rem;
		opacity: 1;
	}

	.footer-bottom {
		padding-top: 1.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
		font-size: 0.85rem;
		opacity: 0.7;
	}

	.footer-bottom-links {
		display: flex;
		gap: 1.5rem;
	}

	.footer-bottom-links a {
		color: rgba(255, 255, 255, 0.85);
		text-decoration: none;
	}

	.footer-bottom-links a:hover {
		color: var(--color-primary);
	}

	@media (max-width: 968px) {
		.footer-grid {
			grid-template-columns: 1fr 1fr;
			gap: 2.5rem;
		}
	}

	@media (max-width: 640px) {
		.footer-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.site-footer {
			padding: 3rem 1rem 1.5rem;
		}

		.footer-bottom {
			flex-direction: column;
			text-align: center;
		}
	}
</style>
