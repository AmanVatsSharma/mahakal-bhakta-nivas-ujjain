---
import { festivals } from '../data/content.js';

const monthIcons: Record<number, string> = {
  1: '<path d="M4 7V4h16v3M9 20h6M12 4v16"/>',
  2: '<path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/>',
  3: '<path d="M12 2v4m0 12v4M2 12h4m12 0h4"/><circle cx="12" cy="12" r="5"/>',
  4: '<path d="M12 3a6 6 0 00-6 6c0 3.3 2.7 9 6 9s6-5.7 6-9a6 6 0 00-6-6z"/><circle cx="12" cy="12" r="2"/>',
  5: '<path d="M12 22c4.97 0 9-4.03 9-9-4.97 0-9 4.03-9 9zM12 22c-4.97 0-9-4.03-9-9 4.97 0 9 4.03 9 9zM12 2c4.97 0 9 4.03 9 9 0-4.97-4.03-9-9-9zM12 2C7.03 2 3 6.03 3 11c0 4.97 4.03 9 9 9"/>',
  6: '<path d="M2 12h4l3-9 4 18 3-9h4"/>',
  7: '<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>',
  8: '<circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 006 0v-1a10 10 0 10-3.92 7.94"/>',
  9: '<rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="9" y1="3" x2="9" y2="21"/>',
  10: '<path d="M12 3l1.912 5.813L20 10l-5.188.672L12 18l-2.812-7.328L4 10l6.088-1.187L12 3z"/>',
  11: '<circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/>',
  12: '<path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/>',
};

const monthLabels = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

function groupByMonth(events: typeof festivals) {
  const map: Record<number, typeof festivals> = {};
  for (const f of events) {
    if (!map[f.month]) map[f.month] = [];
    map[f.month].push(f);
  }
  return map;
}
---

<section class="section festivals-section" id="festivals">
  <div class="container">
    <div class="section-header">
      <span class="section-label">Festival Calendar</span>
      <h2 class="heading-display heading-lg section-title">Festivals in Ujjain & Shravan</h2>
      <p class="section-subtitle">
        Ujjain comes alive during festivals and the holy month of Shravan.
        Book your room well in advance — Mahakal Bhakta Nivas fills up quickly.
      </p>
    </div>

    <div class="festivals-timeline">
      {(() => {
        const grouped = groupByMonth(festivals);
        const sortedMonths = Object.keys(grouped).map(Number).sort((a, b) => a - b);
        return sortedMonths.map((month, idx) => (
          <div class="festival-month" data-index={idx}>
            <div class="festival-month-marker">
              <div class="festival-month-dot">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <Fragment set:html={monthIcons[month] || ''} />
                </svg>
              </div>
              <div class="festival-month-line"></div>
            </div>
            <div class="festival-month-content">
              <div class="festival-month-label">{monthLabels[month - 1]}</div>
              <div class="festival-month-cards">
                {grouped[month].map(f => (
                  <article class="festival-card">
                    <h3 class="festival-card-title">{f.name}</h3>
                    <div class="festival-card-date">
                      {f.day}{f.monthSuffix ? ` ${f.monthSuffix}` : ''} {monthLabels[month - 1]}
                    </div>
                    <p class="festival-card-desc">{f.desc}</p>
                    {f.significance && (
                      <p class="festival-card-sig">{f.significance}</p>
                    )}
                    {f.isShravan && (
                      <span class="festival-shravan-badge">Shravan Special</span>
                    )}
                    {f.bookingNote && (
                      <div class="festival-card-book">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                        {f.bookingNote}
                      </div>
                    )}
                  </article>
                ))}
              </div>
            </div>
          </div>
        ));
      })()}
    </div>

    <div class="festivals-cta">
      <p>Planning for Maha Shivaratri or Shravan month? Book your room early — limited availability.</p>
      <a href={`https://wa.me/${siteConfig.whatsapp}?text=Hi,%20I%20would%20like%20to%20check%20availability`} class="btn btn-whatsapp" target="_blank" rel="noopener">
        Check Availability
      </a>
    </div>
  </div>
</section>

<style>
  .festivals-section {
    background: var(--color-white);
  }

  .festivals-timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-0);
    margin-bottom: var(--space-8);
  }

  .festival-month {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: var(--space-4);
  }

  .festival-month-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .festival-month-dot {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
    color: var(--color-white);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .festival-month-dot svg {
    width: 22px;
    height: 22px;
  }

  .festival-month-line {
    width: 2px;
    flex: 1;
    background: var(--color-sand-200);
    margin-top: var(--space-1);
  }

  .festival-month:last-child .festival-month-line {
    display: none;
  }

  .festival-month-content {
    padding-bottom: var(--space-6);
  }

  .festival-month-label {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .festival-month-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  @media (min-width: 600px) {
    .festival-month-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .festival-card {
    background: var(--color-white);
    border: 1px solid var(--color-sand-100);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    transition: all 0.25s ease;
    position: relative;
  }

  .festival-card:hover {
    border-color: var(--color-gold);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(26, 16, 8, 0.08);
  }

  .festival-card-title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-sand-900);
    margin-bottom: var(--space-1);
  }

  .festival-card-date {
    font-weight: 700;
    font-size: 0.8125rem;
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }

  .festival-card-desc {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-sand-700);
    margin-bottom: var(--space-2);
  }

  .festival-card-sig {
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--color-sand-500);
    line-height: 1.55;
  }

  .festival-shravan-badge {
    display: inline-block;
    background: var(--color-gold);
    color: var(--color-sand-900);
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: var(--space-2);
  }

  .festival-card-book {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: var(--space-3);
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #991b1b;
    padding: 0.625rem 0.875rem;
    border-radius: var(--radius-md);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .festival-card-book svg {
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .festivals-cta {
    background: var(--color-sand-900);
    color: var(--color-white);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  @media (min-width: 640px) {
    .festivals-cta {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .festivals-cta p {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-white);
  }
</style>
