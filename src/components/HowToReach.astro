---
import { howToReach, siteConfig } from '../data/content.js';

const transportIcons = {
  train: '<path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"/><line x1="4" y1="22" x2="4" y2="15"/>',
  flight: '<path d="M17.8 19.2L16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.4-.1.9.3 1.1L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.7.5 1.1.3l.5-.2c.4-.3.6-.7.5-1.1z"/>',
  bus: '<path d="M8 6v6"/><path d="M15 6v6"/><path d="M2 12h20"/><path d="M4 18h16"/><path d="M18 4a2 2 0 012 2v8a2 2 0 01-2 2h-3v6"/><path d="M6 4a2 2 0 00-2 2v8a2 2 0 002 2h3v6"/>',
  car: '<path d="M14 16H9m10 0h3v-3.15a1 1 0 00-.84-.99L16 11l-2.7-3.6a1 1 0 00-.8-.4H5.24a2 2 0 00-1.8 1.1l-.8 1.63A6 6 0 002 12.42V16h2"/><circle cx="6.5" cy="16.5" r="2.5"/><circle cx="16.5" cy="16.5" r="2.5"/>',
};
---

<section class="section reach-section" id="reach">
  <div class="container">
    <div class="section-header">
      <span class="section-label">How to Reach</span>
      <h2 class="heading-display heading-lg section-title">Your yatra to Mahakal starts here</h2>
      <p class="section-subtitle">
        Mahakal Bhakta Nivas is in the heart of Ujjain — just {siteConfig.distanceToTemple} from
        Mahakaleshwar Temple. Here is how to reach us from major cities and transport hubs.
      </p>
    </div>

    <div class="reach-grid">
      {howToReach.map(r => (
        <article class="reach-card">
          <div class="reach-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <Fragment set:html={transportIcons[r.mode] || ''} />
            </svg>
          </div>
          <div>
            <div class="reach-card-mode">{r.from}</div>
            <div class="reach-card-distance">From {r.from}</div>
          </div>
          <div class="reach-card-detail">
            <div class="reach-card-route">
              {r.via && <span class="reach-card-via">via {r.via}</span>}
            </div>
            <div class="reach-card-duration">
              {r.distance} · {r.duration}
            </div>
            {r.note && (
              <p class="reach-card-note">{r.note}</p>
            )}
          </div>
        </article>
      ))}
    </div>

    <div class="reach-cta">
      <p>Need pickup from railway station or airport?</p>
      <a href={`https://wa.me/${siteConfig.whatsapp}?text=Hi,%20please%20arrange%20pickup`} class="btn btn-whatsapp" target="_blank" rel="noopener">
        Arrange Pickup on WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .reach-section {
    background: var(--color-white);
  }

  .reach-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 480px) {
    .reach-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .reach-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-4);
    }
  }

  .reach-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background: var(--color-white);
    border: 1px solid var(--color-sand-100);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    transition: all 0.25s ease;
  }

  .reach-card:hover {
    border-color: var(--color-gold);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(26, 16, 8, 0.08);
  }

  .reach-card-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--color-sand-50);
    color: var(--color-sand-700);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .reach-card-icon svg {
    width: 22px;
    height: 22px;
  }

  .reach-card-mode {
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: 0.125rem;
  }

  .reach-card-distance {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-sand-900);
  }

  .reach-card-via {
    font-size: 0.8125rem;
    color: var(--color-sand-500);
  }

  .reach-card-duration {
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--color-sand-800);
    margin-top: 0.25rem;
  }

  .reach-card-note {
    font-size: 0.8125rem;
    color: var(--color-sand-600);
    margin-top: var(--space-2);
    line-height: 1.5;
  }

  .reach-cta {
    background: var(--color-sand-900);
    color: var(--color-white);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  @media (min-width: 640px) {
    .reach-cta {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .reach-cta p {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-white);
  }

  .reach-cta .btn {
    flex-shrink: 0;
  }
</style>
