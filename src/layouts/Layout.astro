---
interface Props {
	title: string;
	description: string;
	canonical?: string;
	ogImage?: string;
}

const {
	title,
	description,
	canonical = "https://mahakalbhakta.in",
	ogImage = "https://mahakalbhakta.in/images/og-default.jpg"
} = Astro.props;

const siteName = "Mahakal Bhakta Nivas - Dharmashala Ujjain";
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const currentUrl = `${canonical}`;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />

		<!-- Primary SEO Meta Tags -->
		<title set:html={fullTitle} />
		<meta name="description" content={description} />
		<link rel="canonical" href={currentUrl} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={currentUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="en_IN" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Geo Meta Tags for Local SEO -->
		<meta name="geo.region" content="IN-MP" />
		<meta name="geo.placename" content="Ujjain" />
		<meta name="geo.position" content="23.1765;75.7833" />
		<meta name="ICBM" content="23.1765, 75.7833" />

		<!-- Preconnect for performance -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

		<!-- Fonts -->
		<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

		<!-- Favicon (SVG) -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#1e3a5f" />

		<!-- Structured Data: Organization -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Organization",
			"name": "Mahakal Bhakta Nivas",
			"description": "Premium Dharmashala and accommodation near Mahakaleshwar Temple, Ujjain",
			"url": "https://mahakalbhakta.in",
			"telephone": "+919007458189",
			"address": {
				"@type": "PostalAddress",
				"streetAddress": "[INSERT FULL ADDRESS]",
				"addressLocality": "Ujjain",
				"addressRegion": "Madhya Pradesh",
				"postalCode": "456006",
				"addressCountry": "IN"
			},
			"geo": {
				"@type": "GeoCoordinates",
				"latitude": "23.1765",
				"longitude": "75.7833"
			},
			"openingHours": "Mo-Su 00:00-23:59",
			"sameAs": [
				"https://wa.me/919007458189"
			]
		})} />
	</head>
	<body>
		<header class="site-header">
			<div class="container header-inner">
				<a href="/" class="logo" aria-label="Mahakal Bhakta Nivas Home">
					<div class="logo-icon">🕉️</div>
					<div class="logo-text">
						<span class="logo-name">Mahakal Bhakta Nivas</span>
						<span class="logo-sub">Dharmashala · Ujjain</span>
					</div>
				</a>
				<button class="nav-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
					<span></span><span></span><span></span>
				</button>
				<nav class="main-nav" aria-label="Main navigation">
					<ul>
						<li><a href="/" class="nav-link">Home</a></li>
						<li><a href="/rooms/" class="nav-link">Rooms</a></li>
						<li><a href="/about/" class="nav-link">About</a></li>
						<li><a href="/gallery/" class="nav-link">Gallery</a></li>
						<li><a href="/contact/" class="nav-link">Contact</a></li>
						<li>
							<a href="https://wa.me/919007458189?text=Hello,%20I'd%20like%20to%20book%20a%20room"
							   class="btn btn-whatsapp btn-sm" target="_blank" rel="noopener">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.365.195 1.88.118.574-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
								Book Now
							</a>
						</li>
					</ul>
				</nav>
			</div>
		</header>

		<slot />

		<footer class="site-footer">
			<div class="container">
				<div class="footer-grid">
					<div class="footer-brand">
						<div class="logo-icon">🕉️</div>
						<h3>Mahakal Bhakta Nivas</h3>
						<p>Premium stay experience near Mahakaleshwar Temple, Ujjain. Comfort, cleanliness & convenience — the perfect base for your spiritual journey.</p>
						<div class="footer-contact">
							<a href="tel:+919007458189">📞 +91 90074 58189</a>
							<a href="https://wa.me/919007458189" target="_blank" rel="noopener">💬 WhatsApp: 90074 58189</a>
						</div>
					</div>
					<div>
						<h4>Quick Links</h4>
						<ul>
							<li><a href="/">Home</a></li>
							<li><a href="/rooms/">Rooms</a></li>
							<li><a href="/about/">About Us</a></li>
							<li><a href="/gallery/">Gallery</a></li>
							<li><a href="/contact/">Contact</a></li>
						</ul>
					</div>
					<div>
						<h4>Nearby Attractions</h4>
						<ul>
							<li>Mahakaleshwar Temple (0.2 km)</li>
							<li>Ram Ghat (0.8 km)</li>
							<li>Kalbhairav Temple (1.5 km)</li>
							<li>Harsiddhi Temple (2 km)</li>
							<li>Shipra River Ghats (0.5 km)</li>
						</ul>
					</div>
				</div>
				<div class="footer-bottom">
					<p>&copy; {new Date().getFullYear()} Mahakal Bhakta Nivas. All rights reserved. | Designed with devotion for devotees.</p>
				</div>
			</div>
		</footer>

		<!-- Sticky Mobile CTA Bar -->
		<div class="mobile-cta-bar">
			<a href="tel:+919007458189" class="mobile-cta-btn call">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
				<span>Call</span>
			</a>
			<a href="https://wa.me/919007458189?text=Hello,%20I'd%20like%20to%20book%20a%20room%20at%20Mahakal%20Bhakta%20Nivas"
			   class="mobile-cta-btn whatsapp" target="_blank" rel="noopener">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.365.195 1.88.118.574-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
				<span>WhatsApp</span>
			</a>
		</div>

		<script>
			// Mobile navigation toggle
			const navToggle = document.querySelector('.nav-toggle');
			const mainNav = document.querySelector('.main-nav');

			if (navToggle && mainNav) {
				navToggle.addEventListener('click', () => {
					const isOpen = mainNav.classList.toggle('is-open');
					navToggle.setAttribute('aria-expanded', isOpen);
					navToggle.classList.toggle('is-active', isOpen);
				});

				// Close nav on link click (mobile)
				mainNav.querySelectorAll('.nav-link').forEach(link => {
					link.addEventListener('click', () => {
						mainNav.classList.remove('is-open');
						navToggle.setAttribute('aria-expanded', 'false');
						navToggle.classList.remove('is-active');
					});
				});
			}

			// Hide mobile CTA bar when footer is visible
			const mobileBar = document.querySelector('.mobile-cta-bar');
			const footer = document.querySelector('.site-footer');

			if (mobileBar && footer) {
				const observer = new IntersectionObserver((entries) => {
					entries.forEach(entry => {
						mobileBar.style.opacity = entry.isIntersecting ? '0' : '1';
						mobileBar.style.pointerEvents = entry.isIntersecting ? 'none' : 'auto';
					});
				}, { threshold: 0.1 });

				observer.observe(footer);
			}
		</script>
	</body>
</html>
