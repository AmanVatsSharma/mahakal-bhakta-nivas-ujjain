---
import '../styles/global.css';
interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	ogImage?: string;
	bodyClass?: string;
}

const {
	title = 'Mahakal Bhakta Nivas - Best Dharmashala Near Mahakaleshwar Temple, Ujjain',
	description = 'Book your stay at Mahakal Bhakta Nivas, the most trusted dharmashala in Ujjain. Clean rooms, walking distance to Mahakaleshwar Jyotirlinga, affordable prices.',
	canonical = 'https://www.shrimahakalbhaktniwasujjain.com/',
	ogImage = 'https://www.shrimahakalbhaktniwasujjain.com/og-image.jpg',
	bodyClass = '',
} = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap" rel="stylesheet">
	<link rel="icon" href="/favicon.svg" type="image/svg+xml">
	<link rel="apple-touch-icon" href="/favicon.svg">
	<meta name="description" content={description} />

	<!-- Canonical URL -->
	<link rel="canonical" href={canonical} />

	<!-- Open Graph -->
	<meta property="og:type" content="website" />
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:url" content={canonical} />
	<meta property="og:image" content={ogImage} />
	<meta property="og:locale" content="en_IN" />

	<!-- Twitter -->
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />

	<title>{title}</title>

	<!-- Schema.org JSON-LD for LodgingBusiness -->
	<script type="application/ld+json" is:inline set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "LodgingBusiness",
		"name": "Mahakal Bhakta Nivas",
		"description": description,
		"url": "https://www.shrimahakalbhaktniwasujjain.com",
		"telephone": "+919989898989",
		"address": {
			"@type": "PostalAddress",
			"streetAddress": "Near Mahakaleshwar Temple, Gopal Mandir Road",
			"addressLocality": "Ujjain",
			"addressRegion": "Madhya Pradesh",
			"postalCode": "456006",
			"addressCountry": "IN"
		},
		"geo": {
			"@type": "GeoCoordinates",
			"latitude": "23.1829",
			"longitude": "75.7686"
		},
		"openingHoursSpecification": {
			"@type": "OpeningHoursSpecification",
			"dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
			"opens": "00:00",
			"closes": "23:59"
		},
		"image": ogImage,
		"priceRange": "₹₹",
		"sameAs": []
	})} />

	<!-- BreadcrumbList -->
	<script type="application/ld+json" is:inline set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		"itemListElement": [
			{ "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.shrimahakalbhaktniwasujjain.com/" }
		]
	})} />
</head>
<body class={bodyClass}>
	<slot />

	<!-- Floating WhatsApp Button (desktop) -->
	<a
		href="https://wa.me/919989898989?text=Namaste!%20I%20would%20like%20to%20inquire%20about%20rooms%20at%20Mahakal%20Bhakta%20Nivas,%20Ujjain."
		target="_blank"
		rel="noopener noreferrer"
		aria-label="Chat with us on WhatsApp"
		class="floating-whatsapp"
	>
		<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
			<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
		</svg>
	</a>
</body>
</html>

<style>
	/* Floating WhatsApp Button */
	.floating-whatsapp {
		position: fixed;
		bottom: 1.5rem;
		right: 1rem;
		width: 56px;
		height: 56px;
		background: #25d366;
		color: white;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 4px 14px rgba(37, 211, 102, 0.5);
		z-index: 80;
		transition: all 0.3s ease;
	}

	.floating-whatsapp:hover {
		transform: scale(1.1);
		box-shadow: 0 6px 20px rgba(37, 211, 102, 0.6);
	}

	.floating-whatsapp svg {
		width: 28px;
		height: 28px;
	}

	@media (max-width: 899px) {
		.floating-whatsapp {
			bottom: 85px;
			width: 48px;
			height: 48px;
		}
	}
</style>
