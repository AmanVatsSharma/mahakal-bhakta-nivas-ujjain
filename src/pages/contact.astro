---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, CONTACT } from '../config';
const waChat = `https://wa.me/${CONTACT.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent("Hello, I'd like to know more about Mahakal Bhakta Nivas")}`;
const pageTitle = `Contact ${SITE.name} Ujjain — Phone, WhatsApp & Address Near Mahakaleshwar Temple`;
const pageDescription = `Contact Mahakal Bhakta Nivas, Gopal Mandir Road, 200 m from Mahakaleshwar Temple, Ujjain 456006. Call or WhatsApp ${CONTACT.phoneDisplay} for room bookings — replies within minutes.`;
---

<BaseLayout title={pageTitle} description={pageDescription} canonical="/contact" breadcrumbs={[{ name: 'Contact', path: '/contact' }]}>
    <main>
        <!-- Contact Hero -->
        <section class="contact-hero">
            <div class="container">
                <span class="section-tag">Get In Touch</span>
                <h1>Contact Us</h1>
                <p class="hero-lead">Have a question or ready to book? Reach out to us directly — we're here to help make your spiritual journey comfortable.</p>
            </div>
        </section>

        <!-- Contact Cards -->
        <section class="contact-section">
            <div class="container">
                <div class="contact-grid">
                    <!-- Phone -->
                    <a href={`tel:${CONTACT.phone}`} class="contact-card" itemscope itemtype="https://schema.org/ContactPoint">
                        <div class="contact-icon">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                            </svg>
                        </div>
                        <h3>Phone</h3>
                        <p class="contact-value" itemprop="telephone">{CONTACT.phoneDisplay}</p>
                        <p class="contact-hint">Call us directly</p>
                    </a>

                    <!-- WhatsApp -->
                    <a href={waChat}
                       class="contact-card whatsapp" target="_blank" rel="noopener" itemscope itemtype="https://schema.org/ContactPoint">
                        <div class="contact-icon">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.365.195 1.88.118.574-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
                            </svg>
                        </div>
                        <h3>WhatsApp</h3>
                        <p class="contact-value" itemprop="contactType">{CONTACT.phoneDisplay}</p>
                        <p class="contact-hint">Quick replies, booking confirmations</p>
                    </a>

                    <!-- Address -->
                    <div class="contact-card" itemscope itemtype="https://schema.org/PostalAddress">
                        <div class="contact-icon">
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                        </div>
                        <h3>Address</h3>
                        <p class="contact-value" itemprop="streetAddress">
                            Near Mahakaleshwar Temple,<br>
                            Gopal Mandir Road,<br>
                            Ujjain, Madhya Pradesh<br>
                            456006, India
                        </p>
                        <p class="contact-hint">200 m — 2 min walk from temple</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Map Section -->
        <section class="map-section">
            <div class="container">
                <h2 class="section-title">Find Us</h2>
                <p class="section-subtitle">Located in the heart of Ujjain, just a short walk from the Mahakaleshwar Jyotirlinga.</p>
            </div>
            <div class="map-container">
                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3672.333!2d75.7833!3d23.1765!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMjPCsDExJzA1LjIiTiA3NcKwNDUnMjQuNCJF!5e0!3m2!1sen!2sin!4v1690000000000"
                    width="100%"
                    height="450"
                    style="border:0; display:block;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title="Mahakal Bhakta Nivas Location on Google Maps"
                    itemprop="hasMap">
                </iframe>
            </div>
        </section>

        <!-- CTA -->
        <section class="cta-section">
            <div class="container">
                <div class="cta-card">
                    <h2>Ready to Book?</h2>
                    <p>Call or WhatsApp us for instant booking confirmation.</p>
                    <div class="cta-buttons">
                        <a href={waChat}
                           class="btn btn-whatsapp" target="_blank" rel="noopener">
                            WhatsApp Us
                        </a>
                        <a href={`tel:${CONTACT.phone}`} class="btn btn-call">
                            Call Now
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>

<style>
    .contact-hero {
        padding: var(--space-16) 0;
        background: linear-gradient(135deg, var(--primary-900) 0%, var(--primary-800) 100%);
        text-align: center;
    }

    .contact-hero .section-tag {
        display: inline-block;
        background: var(--accent);
        color: var(--cream);
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-full);
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: var(--space-4);
    }

    .contact-hero h1 {
        font-size: clamp(2rem, 5vw, 3rem);
        color: var(--cream);
        margin-bottom: var(--space-4);
    }

    .contact-hero .hero-lead {
        color: var(--primary-200);
        font-size: 1.1rem;
        max-width: 600px;
        margin: 0 auto;
    }

    .contact-section {
        padding: var(--space-16) 0;
        background: var(--cream);
    }

    .contact-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-6);
        margin-top: var(--space-10);
        max-width: 900px;
        margin-left: auto;
        margin-right: auto;
    }

    .contact-card {
        background: white;
        border-radius: var(--radius-xl);
        padding: var(--space-8);
        text-align: center;
        box-shadow: var(--shadow-sm);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        text-decoration: none;
        color: inherit;
        display: block;
        border: 2px solid transparent;
    }

    .contact-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-lg);
    }

    .contact-card.whatsapp {
        border-color: #25D366;
    }

    .contact-card.whatsapp:hover {
        background: #f0faf3;
    }

    .contact-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto var(--space-4);
        background: var(--primary-50);
        color: var(--primary-700);
    }

    .contact-card.whatsapp .contact-icon {
        background: #e8f9ef;
        color: #25D366;
    }

    .contact-card h3 {
        font-size: 1.1rem;
        color: var(--primary-900);
        margin-bottom: var(--space-2);
    }

    .contact-value {
        font-size: 1.15rem;
        font-weight: 600;
        color: var(--primary-700);
        margin-bottom: var(--space-1);
    }

    .contact-hint {
        font-size: 0.85rem;
        color: var(--gray-500);
    }

    /* Map */
    .map-section {
        background: white;
        padding-bottom: var(--space-16);
    }

    .map-section .section-title {
        text-align: center;
        margin-bottom: var(--space-2);
    }

    .section-subtitle {
        text-align: center;
        color: var(--gray-500);
        margin-bottom: var(--space-8);
    }

    .map-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 var(--space-4);
        border-radius: var(--radius-xl);
        overflow: hidden;
        box-shadow: var(--shadow-lg);
    }

    .map-container iframe {
        display: block;
        width: 100%;
    }

    @media (min-width: 768px) {
        .contact-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }
</style>
