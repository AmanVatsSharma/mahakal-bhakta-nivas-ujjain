---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const faqs = [
  {
    q: 'How far is Mahakal Bhakta Nivas from Mahakaleshwar Temple?',
    a: 'We are located just 500 meters (approximately 5-7 minutes walk) from the Mahakaleshwar Jyotirlinga Temple. The location is ideal for devotees who want to attend multiple darshans in a day. We also assist with special darshan arrangements and guide bookings.',
  },
  {
    q: 'What are the room rates?',
    a: 'Our room rates start from ₹350 per night for dormitory beds, ₹600 for Non-AC rooms, ₹1,200 for Deluxe AC rooms, ₹1,800 for Family Suites, and ₹2,500 for our premium Temple View rooms. All prices are per night and include complimentary hot water. We also offer special discounts for group bookings of 10+ rooms.',
  },
  {
    q: 'Is vegetarian food available?',
    a: 'Yes, we have a pure vegetarian in-house restaurant serving delicious North Indian, Gujarati, and South Indian meals. Our kitchen follows strict sattvic preparation methods. We also offer thali meals, snacks, and prasadam packing services.',
  },
  {
    q: 'How do I make a booking?',
    a: 'You can book through our website form, call us directly at +91 98765 43210, or send a message on WhatsApp. For advance bookings, we require 30% advance payment. Walk-ins are welcome subject to availability during peak seasons like Simhastha and Mahashivratri.',
  },
  {
    q: 'Do you provide temple guides?',
    a: 'Yes! We arrange experienced temple guides who can explain the history and significance of Mahakaleshwar Temple and other important sites in Ujjain. The guide service can be booked at the reception or requested in advance via WhatsApp.',
  },
  {
    q: 'What is the cancellation policy?',
    a: 'Free cancellation up to 48 hours before check-in. Cancellations within 48 hours will incur a charge of one night\'s stay. No-shows are charged for the entire booking. During special events like Simhastha, a stricter 7-day cancellation policy applies.',
  },
  {
    q: 'Is parking available?',
    a: 'Yes, we have free parking available for cars, bikes, and buses on our premises. Our parking can accommodate up to 30 vehicles. For large group bookings or bus arrivals, please inform us in advance so we can arrange adequate parking space.',
  },
  {
    q: 'Do you arrange darshan tickets?',
    a: 'We assist our guests with darshan arrangements including helping with online bookings for the Mahakaleshwar Temple, Jyotirlinga darshan, and special pujas. While we don\'t sell tickets directly, our staff at the reception will guide you through the process.',
  },
];
---

<BaseLayout
  title="FAQ - Mahakal Bhakta Nivas Ujjain"
  description="Frequently asked questions about Mahakal Bhakta Nivas dharmashala in Ujjain. Find answers about booking, room rates, temple distance, food, parking, and more."
>
  <Header />

  <section class="section" style="padding-top:100px">
    <div class="container">
      <div class="section-header">
        <span class="section-label">FAQ</span>
        <h1 class="heading-display heading-lg section-title">Frequently Asked Questions</h1>
        <p class="section-subtitle">
          Everything you need to know about staying at Mahakal Bhakta Nivas in Ujjain.
        </p>
      </div>

      <div class="faq-list stagger-children">
        {faqs.map((faq, i) => (
          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              <span>{faq.q}</span>
              <svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </button>
            <div class="faq-answer">
              <div class="faq-answer-inner">{faq.a}</div>
            </div>
          </div>
        ))}
      </div>

      <div style="text-align:center;margin-top:var(--space-12);padding:var(--space-8);background:var(--color-sand-50);border-radius:var(--radius-lg)">
        <h3 class="heading-display heading-md" style="margin-bottom:var(--space-3)">Still Have Questions?</h3>
        <p style="color:var(--color-sand-700);margin-bottom:var(--space-6);max-width:500px;margin-inline:auto">
          Our team is available 24/7 to help you plan your spiritual journey to Ujjain.
        </p>
        <div style="display:flex;gap:var(--space-3);justify-content:center;flex-wrap:wrap">
          <a href="tel:+919876543210" class="btn btn-dark btn-lg">Call: +91 98765 43210</a>
          <a href="https://wa.me/919876543210" class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener">Chat on WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <div class="floating-cta">
    <a href="https://wa.me/919876543210" class="btn btn-whatsapp" target="_blank" rel="noopener">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      WhatsApp
    </a>
    <a href="tel:+919876543210" class="btn btn-call">Call</a>
    <a href="#faq" class="btn btn-primary">FAQ</a>
  </div>

  <script>
    document.querySelectorAll('.faq-question').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.parentElement;
        const wasOpen = item.classList.contains('open');
        document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
        if (!wasOpen) item.classList.add('open');
        btn.setAttribute('aria-expanded', String(!wasOpen));
      });
    });
  </script>
</BaseLayout>
