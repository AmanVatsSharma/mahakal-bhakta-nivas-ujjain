---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
const title = "Photo Gallery | Rooms & Dharamshala — Mahakal Bhakta Nivas Ujjain";
const desc = "Real photos of Mahakal Bhakta Nivas Ujjain — our 2, 3 and 4 bed rooms, Deluxe and Luxury Suites, dining area and the temple quarter, 200 m from Mahakaleshwar Temple.";
---

<BaseLayout title={title} description={desc} canonical="/gallery" breadcrumbs={[{ name: 'Gallery', path: '/gallery' }]}>
  <Header />
  <main>
    <section class="page-hero">
      <div class="container">
        <nav aria-label="Breadcrumb" class="breadcrumb">
          <a href="/">Home</a> <span aria-hidden="true">›</span> <span>Gallery</span>
        </nav>
        <h1>Photo Gallery</h1>
        <p>Real photos of our rooms and the sacred surroundings of Ujjain — no stock images</p>
      </div>
    </section>
    <section class="gallery-content">
      <div class="container">
        <p class="gallery-intro">
          Every room photo below is of an actual room at Mahakal Bhakta Nivas on Gopal Mandir Road, 200 metres from the Mahakaleshwar Temple gate — from the ₹1,250 2 Bed Non-AC to the ₹4,050 Luxury Suite. The rest of the gallery is the world our guests walk through: the temple quarter, the Shipra ghats and the lanes of old Ujjain.
        </p>
        <div class="gallery-grid" role="list">
          {
            [
              { src: '/rooms/LuxurySuite4050.jpeg', alt: 'Luxury Suite with king bed and premium interiors at Mahakal Bhakta Nivas' },
              { src: '/rooms/Deluxe2450.jpeg', alt: 'Deluxe Room with king bed, AC and TV at Mahakal Bhakta Nivas' },
              { src: '/rooms/2BedRoomAC1650.jpeg', alt: '2 Bed AC Room at Mahakal Bhakta Nivas near Mahakaleshwar Temple' },
              { src: '/rooms/4BedRoomAC2475.jpeg', alt: '4 Bed AC Family Room at Mahakal Bhakta Nivas Ujjain' },
              { src: '/rooms/3BedRoomNonAC1785.jpeg', alt: '3 Bed Non-AC Room at Mahakal Bhakta Nivas' },
              { src: '/rooms/DeluxeSuite3150.jpeg', alt: 'Deluxe Suite at Mahakal Bhakta Nivas with premium interiors' },
              { src: '/gallery/dining.jpg', alt: 'Pure vegetarian satvik dining at the dharamshala' },
              { src: '/gallery/reception.jpg', alt: 'Reception and help desk at Mahakal Bhakta Nivas' },
              { src: '/gallery/temple-1.jpg', alt: 'Mahakaleshwar Temple, 200 metres from the dharamshala' },
              { src: '/gallery/4.jpg', alt: 'Ram Ghat on the Shipra river, 500 metres from the dharamshala' },
              { src: '/gallery/3.jpg', alt: 'The temple quarter of old Ujjain around Gopal Mandir Road' },
              { src: '/gallery/8.jpg', alt: 'Devotional life and temple spires of Ujjain' },
            ].map(img => (
              <div class="gallery-item" role="listitem">
                <img src={img.src} alt={img.alt} loading="lazy" />
              </div>
            ))
          }
        </div>
        <div class="gallery-cta">
          <p>Like what you see? <a href="/rooms/">See all 9 room types with tariff →</a> or <a href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener">ask us for recent photos on WhatsApp 💬</a></p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page-hero { background: var(--c-cream); padding: 32px 0 28px; border-bottom: 1px solid rgba(0,0,0,0.05); }
  .breadcrumb { font-size: 13px; color: #888; margin-bottom: 14px; }
  .breadcrumb a { color: var(--c-maroon); }
  .page-hero h1 { font-family: var(--font-dev); font-size: clamp(1.5rem, 4vw, 2rem); color: var(--c-maroon); margin-bottom: 8px; }
  .page-hero p { font-size: 14px; color: #666; }
  .gallery-content { padding: 36px 0; }
  .gallery-intro { max-width: 760px; margin: 0 auto 22px; font-size: 14.5px; color: #555; line-height: 1.7; text-align: center; }
  .gallery-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .gallery-item { aspect-ratio: 4/3; overflow: hidden; border-radius: 10px; }
  .gallery-item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
  .gallery-item:hover img { transform: scale(1.04); }
  .gallery-cta { text-align: center; margin-top: 24px; padding: 20px; color: #888; font-size: 14px; }
  .gallery-cta a { color: var(--c-maroon); font-weight: 600; }

  @media (min-width: 700px) {
    .gallery-grid { grid-template-columns: repeat(4, 1fr); }
  }
</style>
