---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
const title = "Gallery | Mahakal Bhakta Nivas Ujjain";
const desc = "View photos of our rooms, common areas, and surroundings at Mahakal Bhakta Nivas dharmashala in Ujjain.";
---

<BaseLayout title={title} description={desc}>
  <Header />
  <main>
    <section class="page-hero">
      <div class="container">
        <nav aria-label="Breadcrumb" class="breadcrumb">
          <a href="/">Home</a> <span aria-hidden="true">›</span> <span>Gallery</span>
        </nav>
        <h1>Photo Gallery</h1>
        <p>A glimpse of our dharmashala — rooms, dining, and the temple vicinity</p>
      </div>
    </section>
    <section class="gallery-content">
      <div class="container">
        <div class="gallery-grid" role="list">
          {
            [
              { src: 'https://images.unsplash.com/photo-1566073771259-6a8506099945?w=600&q=80', alt: 'Dharmashala building exterior' },
              { src: 'https://images.unsplash.com/photo-1590490360182-c33d57733427?w=600&q=80', alt: 'Deluxe room interior' },
              { src: 'https://images.unsplash.com/photo-1566665797739-1674de7a421a?w=600&q=80', alt: 'Standard room with attached bathroom' },
              { src: 'https://images.unsplash.com/photo-1540189549336-e6cfcfab9a3f?w=600&q=80', alt: 'Pure vegetarian meals' },
              { src: 'https://images.unsplash.com/photo-1564501049412-61c2a3083791?w=600&q=80', alt: 'Reception area' },
              { src: 'https://images.unsplash.com/photo-1595576508898-0ad5c879a061?w=600&q=80', alt: 'Family dormitory room' },
              { src: 'https://images.unsplash.com/photo-1555854877-bab0e1dac0a7?w=600&q=80', alt: 'Clean dormitory beds' },
              { src: 'https://images.unsplash.com/photo-1548407260-da850faa41e3?w=600&q=80', alt: 'Mahakaleshwar Temple view' },
            ].map(img => (
              <div class="gallery-item" role="listitem">
                <img src={img.src} alt={img.alt} loading="lazy" />
              </div>
            ))
          }
        </div>
        <div class="gallery-cta">
          <p>More photos coming soon — follow us on <a href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener">WhatsApp 💬</a> for live updates</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page-hero { background: var(--c-cream); padding: 32px 0 28px; border-bottom: 1px solid rgba(0,0,0,0.05); }
  .breadcrumb { font-size: 13px; color: #888; margin-bottom: 14px; }
  .breadcrumb a { color: var(--c-maroon); }
  .page-hero h1 { font-family: var(--font-dev); font-size: clamp(1.5rem, 4vw, 2rem); color: var(--c-maroon); margin-bottom: 8px; }
  .page-hero p { font-size: 14px; color: #666; }
  .gallery-content { padding: 36px 0; }
  .gallery-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .gallery-item { aspect-ratio: 4/3; overflow: hidden; border-radius: 10px; }
  .gallery-item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
  .gallery-item:hover img { transform: scale(1.04); }
  .gallery-cta { text-align: center; margin-top: 24px; padding: 20px; color: #888; font-size: 14px; }
  .gallery-cta a { color: var(--c-maroon); font-weight: 600; }

  @media (min-width: 700px) {
    .gallery-grid { grid-template-columns: repeat(4, 1fr); }
  }
</style>
