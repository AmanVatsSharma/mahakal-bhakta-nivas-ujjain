---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../../config';

const POSTS_PER_PAGE = 10;

export function getStaticPaths() {
	return (async () => {
		const POSTS_PER_PAGE_LOCAL = 10;
		const sorted = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
		const totalPages = Math.max(1, Math.ceil(sorted.length / POSTS_PER_PAGE_LOCAL));
		// Pages 2..N only — page 1 is /blog/index.astro (avoids duplicate URL)
		return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => ({
			params: { page: String(i + 2) },
			props: { posts: sorted.slice((i + 1) * POSTS_PER_PAGE_LOCAL, (i + 2) * POSTS_PER_PAGE_LOCAL), pageNumber: i + 2, totalPages },
		}));
	})();
}

const { posts, pageNumber, totalPages } = Astro.props;
const fmtDate = (d: Date) => d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
---

<BaseLayout title={`Blog — Page ${pageNumber} | ${SITE.name}`} description={`Mahakaleshwar pilgrim guides — page ${pageNumber}. Aarti bookings, temple timings, itineraries, and stay advice for Ujjain yatra.`} canonical={`${SITE.url}/blog/page/${pageNumber}/`}>
	<Header />

	<section class="blog-index-hero">
		<div class="container">
			<nav class="crumbs" aria-label="Breadcrumb">
				<a href="/">Home</a> <span aria-hidden="true">›</span> <a href="/blog/">Blog</a> <span aria-hidden="true">›</span> <span class="crumb-current">Page {pageNumber}</span>
			</nav>
			<h1>Pilgrim Guides — Page {pageNumber}</h1>
		</div>
	</section>

	<main class="container blog-main">
		<div class="post-grid">
			{posts.map((post) => (
				<a href={`/blog/${post.id}/`} class="post-card">
					<img src={post.data.heroImage} alt={post.data.heroAlt} loading="lazy" decoding="async" width="400" height="225" />
					<div class="post-card-body">
						<span class="post-card-date"><time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time></span>
						<h2>{post.data.title}</h2>
						<p>{post.data.description}</p>
					</div>
				</a>
			))}
		</div>

		<nav class="pagination" aria-label="Blog pages">
			{pageNumber > 1 && <a href={pageNumber === 2 ? '/blog/' : `/blog/page/${pageNumber - 1}/`} class="page-prev">‹ Prev</a>}
			{Array.from({ length: totalPages }, (_, i) => i + 1).map((n) =>
				n === pageNumber ? (
					<span class="page-current" aria-current="page">{n}</span>
				) : (
					<a href={n === 1 ? '/blog/' : `/blog/page/${n}/`}>{n}</a>
				),
			)}
			{pageNumber < totalPages && <a href={`/blog/page/${pageNumber + 1}/`} class="page-next">Next ›</a>}
		</nav>
	</main>

	<Footer />
</BaseLayout>

<style>
	.blog-index-hero {
		background: linear-gradient(135deg, #fff8ec, #ffefd6);
		border-bottom: 1px solid rgba(217, 119, 6, 0.15);
		padding: 1.1rem 0 2rem;
	}

	.crumbs {
		font-size: 0.82rem;
		color: #8b6f47;
		margin-bottom: 1rem;
	}

	.crumbs a {
		color: #b45309;
		text-decoration: none;
		font-weight: 600;
	}

	.crumbs span[aria-hidden] {
		margin: 0 0.4rem;
	}

	.blog-index-hero h1 {
		font-family: 'Playfair Display', Georgia, serif;
		font-size: clamp(1.6rem, 4.5vw, 2.2rem);
		color: #1c1410;
	}

	.blog-main {
		padding: 2rem 1.25rem 3rem;
	}

	.post-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.3rem;
	}

	.post-card {
		display: flex;
		flex-direction: column;
		background: #fffbf5;
		border: 1px solid rgba(217, 119, 6, 0.15);
		border-radius: 14px;
		overflow: hidden;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.post-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 8px 20px rgba(28, 20, 16, 0.12);
		border-color: rgba(217, 119, 6, 0.35);
	}

	.post-card img {
		width: 100%;
		height: 170px;
		object-fit: cover;
		display: block;
	}

	.post-card-body {
		padding: 1rem 1.1rem 1.2rem;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.post-card-date {
		font-size: 0.72rem;
		color: #b45309;
		font-weight: 700;
	}

	.post-card-body h2 {
		font-size: 1.05rem;
		line-height: 1.35;
		color: #1c1410;
	}

	.post-card-body p {
		font-size: 0.88rem;
		color: #5b4632;
		line-height: 1.55;
	}

	.pagination {
		display: flex;
		gap: 0.5rem;
		justify-content: center;
		margin-top: 2.5rem;
		align-items: center;
		flex-wrap: wrap;
	}

	.pagination a,
	.page-current {
		min-width: 40px;
		height: 40px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0 0.8rem;
		border-radius: 10px;
		text-decoration: none;
		font-weight: 700;
		font-size: 0.9rem;
	}

	.pagination a {
		background: #fffbf5;
		border: 1.5px solid rgba(217, 119, 6, 0.3);
		color: #7c3f0a;
	}

	.pagination a:hover {
		background: #fff3dd;
		border-color: #d97706;
	}

	.page-current {
		background: #d97706;
		color: #fff;
	}
</style>
