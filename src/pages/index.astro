---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const starSvg = `<svg viewBox="0 0 24 24" fill="currentColor" stroke="none" width="20" height="20"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`;

const checkSvg = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>`;

const testimonials = [
  {
    name: 'Rajesh Sharma',
    location: 'Mumbai, Maharashtra',
    text: 'The best dharmashala in Ujjain! Walking distance from Mahakaleshwar temple. The rooms are clean, food is excellent, and the staff is very helpful.',
    initials: 'RS',
    stars: 5,
  },
  {
    name: 'Priya Patel',
    location: 'Ahmedabad, Gujarat',
    text: 'Our family stayed for 3 days during Simhastha. The suite was spacious and comfortable. The prasad service and temple guide arrangements made our trip seamless.',
    initials: 'PP',
    stars: 5,
  },
  {
    name: 'Anil Kumar',
    location: 'Delhi NCR',
    text: 'I visit Ujjain every year for Mahashivratri. Mahakal Bhakta Nivas is my go-to stay. Excellent value for money, hot water available, and very close to the temple.',
    initials: 'AK',
    stars: 5,
  },
];

const amenities = [
  { icon: 'wifi', name: 'Free WiFi' },
  { icon: 'droplet', name: 'Hot Water 24/7' },
  { icon: 'utensils', name: 'Pure Veg Restaurant' },
  { icon: 'car', name: 'Free Parking' },
  { icon: 'tv', name: 'TV in Rooms' },
  { icon: 'heart', name: 'Medical Room' },
  { icon: 'bag', name: 'Prasad Shop' },
  { icon: 'users', name: 'Group Booking' },
  { icon: 'pin', name: 'Temple Guide' },
  { icon: 'clock', name: '24/7 Reception' },
  { icon: 'shield', name: 'Secure Lockers' },
  { icon: 'zap', name: 'Power Backup' },
];

function amenitySvg(type: string) {
  const paths: Record<string, string> = {
    wifi: '<path d="M5 12.55a11 11 0 0114.08 0" /><path d="M1.42 9a16 16 0 0121.16 0" /><path d="M8.53 16.11a6 6 0 016.95 0" /><line x1="12" y1="20" x2="12.01" y2="20" />',
    droplet: '<path d="M12 2.69l5.66 5.66a8 8 0 11-11.31 0z" />',
    utensils: '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 002-2V2" /><path d="M7 2v20" /><path d="M21 2v20" /><path d="M18 12h.01" />',
    car: '<path d="M14 16H9m10 0h3v-3.15a1 1 0 00-.84-.99L16 11l-2.7-3.6a1 1 0 00-.8-.4H5.24a2 2 0 00-1.8 1.1l-.8 1.63A6 6 0 002 12.42V16h2" /><circle cx="6.5" cy="16.5" r="2.5" /><circle cx="16.5" cy="16.5" r="2.5" />',
    tv: '<rect x="2" y="7" width="20" height="15" rx="2" ry="2" /><polyline points="17 2 12 7 7 2" />',
    heart: '<path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z" />',
    bag: '<path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z" /><line x1="3" y1="6" x2="21" y2="6" /><path d="M16 10a4 4 0 01-8 0" />',
    users: '<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 00-3-3.87" /><path d="M16 3.13a4 4 0 010 7.75" />',
    pin: '<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" /><circle cx="12" cy="10" r="3" />',
    clock: '<circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" />',
    shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />',
    zap: '<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />',
  };
  return paths[type] || '';
}
---

<BaseLayout
  title="Mahakal Bhakta Nivas - Best Dharmashala Near Mahakaleshwar Temple Ujjain"
  description="Book comfortable rooms at Mahakal Bhakta Nivas, the best dharmashala near Mahakaleshwar Temple in Ujjain. Clean rooms, pure veg food, 24/7 service. Walk to the temple in 5 minutes."
  canonical="/"
  image="https://mahakalbhaktanivas.in/og-image.jpg"
>
  <Header />

  <!-- ==================== HERO ==================== -->
  <section class="hero" id="home">
    <div class="hero-content">
      <div class="hero-badge">
        <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        #1 Rated Dharmashala in Ujjain
      </div>

      <h1 class="heading-display heading-xl hero-title">
        Your Sacred Stay<br />
        Near <em>Mahakaleshwar</em>
      </h1>

      <p class="hero-subtitle">
        Experience divine comfort just steps from the Jyotirlinga. Clean rooms,
        pure vegetarian meals, and warm hospitality await you at Mahakal Bhakta Nivas.
      </p>

      <div class="hero-ctas">
        <a href="https://wa.me/919876543210?text=Hi,%20I%20would%20like%20to%20book%20a%20room%20at%20Mahakal%20Bhakta%20Nivas" class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Book on WhatsApp
        </a>
        <a href="tel:+919876543210" class="btn btn-call btn-lg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
          </svg>
          Call Now
        </a>
        <a href="#rooms" class="btn btn-secondary btn-lg">View Rooms</a>
      </div>

      <div class="hero-trust">
        <div class="trust-item">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
          <span>4.8/5 Rating</span>
        </div>
        <div class="trust-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
            <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 00-3-3.87" /><path d="M16 3.13a4 4 0 010 7.75" />
          </svg>
          <span>2000+ Happy Guests</span>
        </div>
        <div class="trust-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
            <path d="M12 22s-8-4.5-8-11.8A8 8 0 0112 2a8 8 0 018 8.2c0 7.3-8 11.8-8 11.8z" /><circle cx="12" cy="10" r="3" />
          </svg>
          <span>5 Min from Temple</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== ROOMS ==================== -->
  <section class="section" id="rooms">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Accommodation</span>
        <h2 class="heading-display heading-lg section-title">Our Rooms & Suites</h2>
        <p class="section-subtitle">
          From cozy single rooms to spacious family suites — all designed for a restful spiritual journey.
        </p>
      </div>

      <div class="rooms-grid stagger-children">
        {[
          {
            title: 'Deluxe Room',
            desc: 'Comfortable AC room with queen bed, attached bathroom with hot water, and temple view.',
            price: '₹1,200',
            badge: 'Popular',
            features: ['AC', 'Hot Water', 'Free WiFi', 'TV'],
            image: 'https://images.unsplash.com/photo-1590490360182-c33d57733427?w=600&h=400&fit=crop',
          },
          {
            title: 'Family Suite',
            desc: 'Spacious room with double bed + single bed, perfect for families visiting the temple.',
            price: '₹1,800',
            badge: 'Best Value',
            features: ['AC', 'Hot Water', 'Free WiFi', 'Balcony'],
            image: 'https://images.unsplash.com/photo-1566665797739-1674de7a421a?w=600&h=400&fit=crop',
          },
          {
            title: 'Temple View Room',
            desc: 'Premium room with direct view of Mahakaleshwar Temple gopuram. Wake up to darshan vibes.',
            price: '₹2,500',
            badge: 'Premium',
            features: ['AC', 'Hot Water', 'Free WiFi', 'TV', 'Balcony'],
            image: 'https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?w=600&h=400&fit=crop',
          },
          {
            title: 'Non-AC Room',
            desc: 'Clean, well-ventilated budget room with comfortable beds. Great for pilgrims on a budget.',
            price: '₹600',
            badge: 'Budget',
            features: ['Fan', 'Hot Water', 'Common WiFi'],
            image: 'https://images.unsplash.com/photo-1522771739844-6a9f6d5f14af?w=600&h=400&fit=crop',
          },
          {
            title: 'Dormitory',
            desc: 'Shared accommodation for large groups. Separate spaces for men and women with lockers.',
            price: '₹350',
            badge: 'Group',
            features: ['Fan', 'Hot Water', 'Common WiFi', 'Lockers'],
            image: 'https://images.unsplash.com/photo-1555854877-bab0e1dbfd81?w=600&h=400&fit=crop',
          },
          {
            title: 'Dharamshala Hall',
            desc: 'Large hall for group bookings and satsangs. Mattress arrangement for 50+ people.',
            price: '₹200/bed',
            badge: 'Groups',
            features: ['Common Bath', 'Hot Water', 'Kitchen Access'],
            image: 'https://images.unsplash.com/photo-1497366216548-37526070297c?w=600&h=400&fit=crop',
          },
        ].map((room) => (
          <div class="room-card">
            <div class="room-card-image">
              <img src={room.image} alt={room.title} loading="lazy" />
              <span class="room-badge">{room.badge}</span>
              <span class="room-price-tag">From {room.price}/night</span>
            </div>
            <div class="room-card-body">
              <h3 class="room-card-title">{room.title}</h3>
              <p class="room-card-desc">{room.desc}</p>
              <div class="room-features">
                {room.features.map(f => (
                  <span class="room-feature">{checkSvg} {f}</span>
                ))}
              </div>
              <a href={"https://wa.me/919876543210?text=" + encodeURIComponent("Hi, I would like to inquire about " + room.title)} class="btn btn-primary" target="_blank" rel="noopener">
                Book Now
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== AMENITIES ==================== -->
  <section class="section amenities-section">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Why Choose Us</span>
        <h2 class="heading-display heading-lg section-title">Amenities & Services</h2>
        <p class="section-subtitle">
          Everything you need for a comfortable and spiritually uplifting stay in Ujjain.
        </p>
      </div>

      <div class="amenities-grid stagger-children">
        {amenities.map(a => (
          <div class="amenity-card">
            <div class="amenity-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                {amenitySvg(a.icon)}
              </svg>
            </div>
            <span class="amenity-name">{a.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== LOCATION ==================== -->
  <section class="section" id="location">
    <div class="container">
      <div class="location-grid">
        <div>
          <span class="section-label">Location</span>
          <h2 class="heading-display heading-lg" style="color:var(--color-sand-900);margin-bottom:var(--space-4)">In the Heart of Ujjain</h2>
          <p style="color:var(--color-sand-700);margin-bottom:var(--space-3);line-height:1.7">
            Located just 500 meters from the sacred Mahakaleshwar Jyotirlinga temple,
            Mahakal Bhakta Nivas offers the most convenient stay for devotees visiting Ujjain.
          </p>
          <p style="color:var(--color-sand-700);margin-bottom:var(--space-3);line-height:1.7">
            Our dharmashala is in the bustling temple market area, with easy access to
            the Ram Ghat, Kal Bhairav Temple, and the famous bazaars of Ujjain.
          </p>
          <div class="location-distances">
            <div class="distance-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" /><circle cx="12" cy="10" r="3" />
              </svg>
              <div>
                <strong>500m</strong>
                <span>Mahakaleshwar Temple</span>
              </div>
            </div>
            <div class="distance-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" /><circle cx="12" cy="10" r="3" />
              </svg>
              <div>
                <strong>1.2 km</strong>
                <span>Ram Ghat</span>
              </div>
            </div>
            <div class="distance-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" /><circle cx="12" cy="10" r="3" />
              </svg>
              <div>
                <strong>3.5 km</strong>
                <span>Ujjain Junction</span>
              </div>
            </div>
            <div class="distance-item">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" /><circle cx="12" cy="10" r="3" />
              </svg>
              <div>
                <strong>8 km</strong>
                <span>Ujjain Airport</span>
              </div>
            </div>
          </div>
        </div>
        <div class="location-map">
          <div class="location-map-placeholder">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
            <span>Near Mahakaleshwar Temple, Ujjain, MP 456001</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== TESTIMONIALS ==================== -->
  <section class="section testimonials-section">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Testimonials</span>
        <h2 class="heading-display heading-lg section-title">What Devotees Say</h2>
        <p class="section-subtitle">
          Hear from the thousands of pilgrims who've made Mahakal Bhakta Nivas their home in Ujjain.
        </p>
      </div>

      <div class="testimonials-grid stagger-children">
        {testimonials.map(t => (
          <div class="testimonial-card">
            <div class="testimonial-stars">
              {Array(t.stars).fill(0).map(() => `<span>${starSvg}</span>`).join('')}
            </div>
            <p class="testimonial-text">{t.text}</p>
            <div class="testimonial-author">
              <div class="testimonial-avatar">{t.initials}</div>
              <div>
                <div class="testimonial-name">{t.name}</div>
                <div class="testimonial-location">{t.location}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== BOOKING CTA ==================== -->
  <section class="section booking-section">
    <div class="booking-inner">
      <span class="section-label">Book Your Stay</span>
      <h2 class="heading-display heading-lg section-title" style="color:var(--color-white)">Reserve Your Sacred Stay</h2>
      <p style="color:rgba(255,255,255,0.75);max-width:500px;margin-inline:auto">
        Fill the form below and we'll confirm your booking via WhatsApp or phone within minutes.
      </p>

      <form class="booking-form" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY" />
        <input type="hidden" name="subject" value="Room Booking - Mahakal Bhakta Nivas" />
        <input type="hidden" name="from_name" value="Mahakal Bhakta Nivas Website" />

        <div class="form-grid">
          <div class="form-group">
            <label for="name">Full Name *</label>
            <input type="text" id="name" name="name" placeholder="Your full name" required />
          </div>
          <div class="form-group">
            <label for="phone">Phone Number *</label>
            <input type="tel" id="phone" name="phone" placeholder="+91 98765 43210" required />
          </div>
          <div class="form-group">
            <label for="checkin">Check-in Date *</label>
            <input type="date" id="checkin" name="checkin" required />
          </div>
          <div class="form-group">
            <label for="checkout">Check-out Date *</label>
            <input type="date" id="checkout" name="checkout" required />
          </div>
          <div class="form-group">
            <label for="roomtype">Room Type</label>
            <select id="roomtype" name="roomtype">
              <option value="">Select room type</option>
              <option value="deluxe">Deluxe Room - ₹1,200</option>
              <option value="family">Family Suite - ₹1,800</option>
              <option value="temple-view">Temple View Room - ₹2,500</option>
              <option value="non-ac">Non-AC Room - ₹600</option>
              <option value="dormitory">Dormitory - ₹350</option>
              <option value="hall">Dharamshala Hall - ₹200/bed</option>
            </select>
          </div>
          <div class="form-group">
            <label for="guests">Guests</label>
            <select id="guests" name="guests">
              <option value="1">1 Guest</option>
              <option value="2" selected>2 Guests</option>
              <option value="3">3 Guests</option>
              <option value="4">4 Guests</option>
              <option value="5+">5+ Guests</option>
            </select>
          </div>
          <div class="form-group full-width">
            <label for="message">Special Requests</label>
            <textarea id="message" name="message" rows="3" placeholder="Any special requirements or questions..."></textarea>
          </div>
        </div>
        <button type="submit" class="btn btn-primary btn-lg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" />
          </svg>
          Send Booking Request
        </button>
        <p style="margin-top:var(--space-3);font-size:0.8125rem;color:rgba(255,255,255,0.5)">
          Or call directly: <a href="tel:+919876543210" style="color:var(--color-gold-light)">+91 98765 43210</a>
          or <a href="https://wa.me/919876543210" style="color:var(--color-gold-light)">WhatsApp us</a>
        </p>
      </form>
    </div>
  </section>

  <Footer />

  <!-- Mobile Floating CTA -->
  <div class="floating-cta">
