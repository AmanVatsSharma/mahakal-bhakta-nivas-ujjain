---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, CONTACT, STATS, ROOMS, AMENITIES, TESTIMONIALS, FAQ_DATA, GALLERY_CATEGORIES, GALLERY_ITEMS, NAV_LINKS, POOJAS, FESTIVALS } from '../config';
import Header from '../components/Header.astro';
import BookingDialog from '../components/BookingDialog.astro';
import FaqSchema from '../components/FaqSchema.json';
import { Image } from 'astro:assets';
import heroBg from '../assets/hero-bg.png';

const pageTitle = `${SITE.name} - Best Dharmashala Near Mahakaleshwar Temple, Ujjain`;
const pageDescription = SITE.description;
const pageUrl = `${SITE.url}/`;
const ogImage = `${SITE.url}/og-image.jpg`;
const waLink = `https://wa.me/${CONTACT.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent('Namaste! I would like to book a room at Mahakal Bhakta Nivas, Ujjain.')}`;
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={pageUrl} ogImage={ogImage}>
	<Header />

	<!-- Hero Section: full poster, natural aspect ratio, never cropped — click opens WhatsApp booking -->
	<section class="hero" id="home" aria-label="Mahakal Bhakta Nivas introduction poster">
		<h1 class="sr-only">Dharamshala &amp; Rooms Near Mahakaleshwar Temple, Ujjain — Mahakal Bhakta Nivas</h1>
		<a class="hero-bg hero-link" href={waLink} target="_blank" rel="noopener noreferrer" aria-label="Book a room on WhatsApp — Mahakal Bhakta Nivas, Ujjain">
			<Image src={heroBg} alt="Mahakal Bhakta Nivas Ujjain — rooms and dharamshala near Mahakaleshwar Jyotirlinga temple" widths={[640, 960, 1280, 1600, 2000]} sizes="100vw" loading="eager" fetchpriority="high" />
		</a>
	</section>

	<!-- Booking CTA bar: Book Now (dialog) + Call Now -->
	<section class="hero-cta-bar" aria-label="Book or call">
		<div class="container hero-cta-inner">
			<button type="button" class="cta-btn cta-book" data-open-booking>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
				Book Now
				<span class="cta-note">choose dates &amp; guests</span>
			</button>
			<a href={`tel:${CONTACT.phone.replace(/[^+\d]/g, '')}`} class="cta-btn cta-call">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
				Call Now
				<span class="cta-note">{CONTACT.phoneDisplay}</span>
			</a>
		</div>
	</section>
	<BookingDialog />

	<!-- Trust / Stats Band -->
	<section class="trust-band">
		<div class="container">
			<div class="trust-grid">
				{STATS.map((stat) => (
					<div class="trust-card" key={stat.label}>
						<span class="trust-value">{stat.value}</span>
						<span class="trust-label">{stat.label}</span>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Rooms Section -->
	<section class="rooms-section" id="rooms">
		<div class="container">
			<div class="section-header">
				<span class="section-eyebrow">Accommodation</span>
				<h2>Rooms at Mahakal Bhakta Nivas</h2>
				<p>From budget dormitories to premium family suites — pick the perfect stay for your Ujjain pilgrimage. All rooms are clean, well-ventilated, and just steps from Mahakaleshwar Temple.</p>
			</div>
			<div class="rooms-grid">
				{ROOMS.map((room) => (
					<div class="room-card" key={room.id}>
						<div class="room-image">
							<img src={room.image} alt={room.imageAlt} loading="lazy" width="400" height="260">
							{room.badge && <span class="room-badge">{room.badge}</span>}
						</div>
						<div class="room-details">
							<h3>{room.name}</h3>
							<p class="room-meta">{room.capacity} · {room.size}</p>
							<p>{room.description}</p>
							<ul class="room-features">
								{room.features.map((f) => (
									<li>{f}</li>
								))}
							</ul>
							<div class="room-price-row">
								<span class="room-price">{room.priceText}<span>/night</span></span>
								<a href={`https://wa.me/${SITE.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent(`Hi! I'd like to book the ${room.name} at Mahakal Bhakta Nivas.`)}`} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-sm">
									Book Now
								</a>
							</div>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Amenities -->
	<section class="amenities-section" id="amenities">
		<div class="container">
			<div class="section-header">
				<span class="section-eyebrow">What We Offer</span>
				<h2>Amenities & Facilities</h2>
				<p>We've thought of everything to make your spiritual journey comfortable and hassle-free.</p>
			</div>
			<div class="amenities-grid">
				{AMENITIES.map((a) => (
					<div class="amenity-card" key={a.title}>
						<span class="amenity-icon">{a.icon}</span>
						<h4>{a.title}</h4>
						<p>{a.desc}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Temple & Darshan Info -->
	<section class="temple-section" id="temple">
		<div class="container">
			<div class="temple-layout">
				<div class="temple-info">
					<span class="section-eyebrow">Mahakaleshwar Temple</span>
					<h2>One of the 12 Sacred Jyotirlingas</h2>
					<p class="temple-lead">Mahakaleshwar Jyotirlinga in Ujjain is one of the most revered Shiva temples in India. Located on the banks of the Shipra River, it is believed that Lord Shiva himself dwells here as the Mahakal — the lord of time and death.</p>
					<div class="temple-details">
						<div class="temple-detail">
							<span class="detail-label">Main Aarti Times</span>
							<ul>
								<li><strong>Morning Aarti:</strong> 4:00 AM (Bhasma Aarti — prior booking required)</li>
								<li><strong>Evening Aarti:</strong> 7:00 PM</li>
								<li><strong>Night Aarti:</strong> 11:00 PM</li>
							</ul>
						</div>
						<div class="temple-detail">
							<span class="detail-label">Temple Opening Hours</span>
							<ul>
								<li><strong>Opening:</strong> 4:00 AM</li>
								<li><strong>Closing:</strong> 11:00 PM</li>
								<li><strong>Closed:</strong> None (open all year round)</li>
							</ul>
						</div>
						<div class="temple-detail">
							<span class="detail-label">Dress Code</span>
							<p>Dress modestly — traditional Indian attire preferred. Shorts, sleeveless tops, and leather items are not allowed inside the temple premises.</p>
						</div>
					</div>
					<a href={`https://wa.me/${SITE.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent('I would like information about Bhasma Aarti booking and Mahakaleshwar darshan timings.')}`} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp">
						📿 Get Temple Info via WhatsApp
					</a>
				</div>
				<div class="temple-visual">
					<div class="temple-image-card">
						<img src="/images/gallery/placeholder.webp" alt="Mahakaleshwar Temple Ujjain - Mahakal Jyotirlinga" loading="lazy">
					</div>
					<div class="temple-darshan-card">
						<h4>🕐 Quick Tips for Darshan</h4>
						<ul>
							<li><strong>Bhasma Aarti</strong> — Most auspicious; requires advance booking via the temple's official website or at the temple gate.</li>
							<li><strong>Best Time to Visit</strong> — Early morning (4-7 AM) for darshan with minimal crowd; evening aarti is equally divine.</li>
							<li><strong>Prasadam</strong> — Available at the temple; don't miss the divine Bhasma.</li>
							<li><strong>Nearby Ghats</strong> — Ram Ghat and Shipra Ghat are ideal for evening aarti and a holy dip.</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- How to Reach -->
	<section class="reach-section" id="reach">
		<div class="container">
			<div class="section-header">
				<span class="section-eyebrow">Directions</span>
				<h2>How to Reach Us</h2>
				<p>Ujjain is well-connected by air, rail, and road. Here's how to reach Mahakal Bhakta Nivas from major transit points.</p>
			</div>
			<div class="reach-grid">
				<div class="reach-card">
					<div class="reach-icon">✈️</div>
					<h3>By Air</h3>
					<p class="reach-location">Devi Ahilya Bai Holkar Airport, Indore</p>
					<p>About 55 km from Ujjain. Take a taxi or bus from Indore to Ujjain (approx. 1.5 hours).</p>
				</div>
				<div class="reach-card">
					<div class="reach-icon">🚆</div>
					<h3>By Train</h3>
					<p class="reach-location">Ujjain Junction Railway Station</p>
					<p>Just 3 km away. Auto-rickshaws and taxis are available outside the station (10 min ride).</p>
				</div>
				<div class="reach-card">
					<div class="reach-icon">🚌</div>
					<h3>By Bus</h3>
					<p class="reach-location">Ujjain ISBT / Private Bus Stand</p>
					<p>Direct buses from Indore, Bhopal, Kota, and Jaipur. Walking distance to our location.</p>
				</div>
				<div class="reach-card">
					<div class="reach-icon">🚗</div>
					<h3>By Car / Taxi</h3>
					<p class="reach-location">Near Mahakaleshwar Temple, Ujjain</p>
					<p>Google Maps: Search "Mahakal Bhakta Nivas Ujjain". Free parking available at our premises.</p>
				</div>
			</div>
			<div class="reach-cta">
				<a href="https://maps.google.com/?q=Mahakaleshwar+Temple+Ujjain" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
					📍 Get Directions on Google Maps
				</a>
			</div>
		</div>
	</section>

	<!-- Pooja & Seva -->
	<section class="seva-section" id="seva">
		<div class="container">
			<div class="section-header">
				<span class="section-eyebrow">Spiritual Services</span>
				<h2>Pooja & Seva Offerings</h2>
				<p>Enhance your spiritual journey with traditional pooja arrangements and temple services we can help you coordinate.</p>
			</div>
			<div class="seva-grid">
				<div class="seva-card">
					<div class="seva-icon">🔥</div>
					<h4>Rudrabhishek</h4>
					<p>Sacred Lord Shiva abhishek with chanting of the Rudram. Available for individual and family bookings.</p>
				</div>
				<div class="seva-card">
					<div class="seva-icon">🪔</div>
					<h4>Deep Dan</h4>
					<p>Offer a lamp at Mahakaleshwar temple for divine blessings and peace.</p>
				</div>
				<div class="seva-card">
					<div class="seva-icon">🌿</div>
					<h4>Satvik Thali</h4>
					<p>Pure vegetarian meals prepared with devotion — available for breakfast, lunch, and dinner.</p>
				</div>
				<div class="seva-card">
					<div class="seva-icon">📿</div>
					<h4>Bhasma Aarti Booking</h4>
					<p>We'll help you arrange the famous Bhasma Aarti — the most coveted pooja at Mahakaleshwar Temple.</p>
				</div>
				<div class="seva-card">
					<div class="seva-icon">🎉</div>
					<h4>Group / Festival Arrangements</h4>
					<p>Special arrangements during Mahashivratri, Kumbh Mela, and other festivals. Contact us for group bookings.</p>
				</div>
				<div class="seva-card">
					<div class="seva-icon">🛺</div>
					<h4>Local Transport</h4>
					<p>Temple pick-up & drop-off, local sightseeing tours, and cab arrangements for Ujjain and nearby sites.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Festival Calendar -->
	<section class="festival-section" id="festivals">
		<div class="container">
			<div class="section-header">
				<span class="section-eyebrow">When to Visit</span>
				<h2>Ujjain's Sacred Calendar</h2>
				<p>Plan your visit around these auspicious dates for an unforgettable spiritual experience.</p>
			</div>
			<div class="festival-grid">
				{[
					{ name: 'Mahashivratri', date: 'Feb–Mar (annual)', desc: 'The most important night dedicated to Lord Shiva. Entire Ujjain transforms into a sea of devotees. Book 2-3 months in advance.' },
					{ name: 'Kumbh Mela', date: 'Every 12 years', desc: 'Ujjain hosts one of the four Kumbh Melas. Millions gather for the sacred bath in the Shipra River. Next expected: 2028.' },
					{ name: 'Simhastha Kumbh', date: 'Next: 2028', desc: 'The grand Kumbh of Ujjain — once in 12 years. Special arrangements for devotees worldwide.' },
					{ name: 'Nagar Kirtan', date: 'Monthly (Sawan)', desc: 'Devotional processions during the holy month of Shravan. Every Monday is especially significant at Mahakaleshwar.' },
					{ name: 'Anant Chaturdashi', date: 'Sep–Oct (annual)', desc: 'Dedicated to Lord Anant (Vishnu). Special poojas and rituals at the temple.' },
					{ name: 'Diwali', date: 'Oct–Nov (annual)', desc: 'The entire city of Ujjain lights up. Temple celebrations are magnificent during Deepavali.' },
				].map((festival) => (
					<div class="festival-card" key={festival.name}>
						<div class="festival-name">{festival.name}</div>
						<div class="festival-date">📅 {festival.date}</div>
						<p>{festival.desc}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Testimonials -->
	<section class="testimonials-section" id="testimonials">
		<div class="container">
			<div class="section-header">
				<span class="section-eyebrow">Guest Reviews</span>
				<h2>What Our Guests Say</h2>
				<p>Trusted by thousands of devotees visiting Mahakaleshwar Temple every year.</p>
			</div>
			<div class="testimonials-grid">
				{TESTIMONIALS.map((t) => (
					<div class="testimonial-card" key={t.name}>
						<div class="testimonial-header">
							<div class="testimonial-avatar">{t.name.charAt(0)}</div>
							<div>
								<strong>{t.name}</strong>
								<span class="testimonial-location">{t.location}</span>
							</div>
							<div class="testimonial-rating">{'⭐'.repeat(t.rating)}</div>
						</div>
						<p class="testimonial-text">"{t.text}"</p>
						<span class="testimonial-date">{t.date}</span>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Gallery -->
	<section class="gallery-section" id="gallery">
		<div class="container">
			<div class="section-header">
				<span class="section-eyebrow">Gallery</span>
				<h2>Photos of Mahakal Bhakta Nivas</h2>
				<p>Take a visual tour of our dharmashala, rooms, and the sacred surroundings of Ujjain.</p>
			</div>
			<div class="gallery-grid">
				{GALLERY_ITEMS.map((item) => (
					<div class="gallery-item" key={item.id}>
						<img src={item.src} alt={item.alt} loading="lazy" width="400" height="300">
					</div>
				))}
			</div>
			<div class="gallery-note">
				<p>📸 Photos are for reference only. Actual rooms may vary slightly.</p>
			</div>
		</div>
	</section>

	<!-- FAQ Section -->
	<section class="faq-section" id="faq">
		<div class="container">
			<div class="section-header">
				<span class="section-eyebrow">Common Questions</span>
				<h2>Frequently Asked Questions</h2>
				<p>Everything you need to know about staying at Mahakal Bhakta Nivas, Ujjain.</p>
			</div>
			<div class="faq-grid">
				{FAQ_DATA.map((faq, i) => (
					<div class="faq-item" key={i}>
						<h4 class="faq-question">{faq.question}</h4>
						<p class="faq-answer">{faq.answer}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Location / Map -->
	<section class="location-section" id="location">
		<div class="container">
			<div class="section-header">
				<span class="section-eyebrow">Visit Us</span>
				<h2>Our Location in Ujjain</h2>
				<p>We are located near the Mahakaleshwar Temple in the heart of Ujjain — walkable to all major attractions.</p>
			</div>
			<div class="location-grid">
				<div class="location-info">
					<div class="location-card">
						<h4>📍 Address</h4>
						<p>Near Mahakaleshwar Temple, Gopal Mandir Road, Ujjain, MP 456006</p>
					</div>
					<div class="location-card">
						<h4>📞 Contact</h4>
						<p><a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a></p>
						<p><a href={`https://wa.me/${SITE.whatsapp.replace(/\D/g, '')}`} target="_blank" rel="noopener noreferrer">WhatsApp: {SITE.phoneDisplay}</a></p>
					</div>
					<div class="location-card">
						<h4>⏰ Hours</h4>
						<p>Open 24 hours, 7 days a week</p>
					</div>
					<div class="location-landmarks">
						<h4>🏛️ Nearby Attractions</h4>
						<div class="landmark-list">
							{[
								{ name: 'Mahakaleshwar Temple', dist: '200 m', time: '2 min walk' },
								{ name: 'Ram Ghat', dist: '500 m', time: '8 min walk' },
								{ name: 'Gopal Mandir', dist: '1.5 km', time: '20 min walk' },
								{ name: 'Harsiddhi Temple', dist: '2 km', time: '25 min walk' },
								{ name: 'Ujjain Junction', dist: '3 km', time: '10 min auto' },
							].map((lm) => (
								<div class="landmark" key={lm.name}>
									<span class="lm-name">{lm.name}</span>
									<span class="lm-dist">{lm.dist} ({lm.time})</span>
								</div>
							))}
						</div>
					</div>
				</div>
				<div class="map-wrapper">
					<iframe
						src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3680.5!2d75.768!3d23.182!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMjPCsDEwJzU1LjIiTiA3NcKwNDYnMDQuOCJF!5e0!3m2!1sen!2sin!4v1700000000000"
						width="100%"
						height="450"
						style="border:0; border-radius: 12px;"
						allowfullscreen=""
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						title="Mahakal Bhakta Nivas location on Google Maps"
					></iframe>
				</div>
			</div>
		</div>
	</section>

	<!-- Contact Section -->
	<section class="contact-section" id="contact">
		<div class="container">
			<div class="contact-grid">
				<div class="contact-info">
					<span class="section-eyebrow">Get In Touch</span>
					<h2>Book Your Stay at Mahakal Bhakta Nivas</h2>
					<p>Whether you are coming for Mahashivratri, a regular darshan trip, or a family vacation — we have the right room for you. Reach out today!</p>
					<div class="contact-methods">
						<a href={`tel:${SITE.phone}`} class="contact-method">
							<span class="cm-icon">📞</span>
							<div>
								<span class="cm-label">Call</span>
								<span class="cm-value">{SITE.phoneDisplay}</span>
							</div>
						</a>
						<a href={`https://wa.me/${SITE.whatsapp.replace(/\D/g, '')}?text=${encodeURIComponent('Namaste! I would like to inquire about rooms and availability at Mahakal Bhakta Nivas.')}`} class="contact-method" target="_blank" rel="noopener noreferrer">
							<span class="cm-icon">💬</span>
							<div>
								<span class="cm-label">WhatsApp</span>
								<span class="cm-value">Quick Reply</span>
							</div>
						</a>
						<a href={`mailto:${SITE.email}`} class="contact-method">
							<span class="cm-icon">✉️</span>
							<div>
								<span class="cm-label">Email</span>
								<span class="cm-value">{SITE.email}</span>
							</div>
						</a>
					</div>
				</div>
				<form class="booking-form" id="booking-form" action="#" method="POST">
					<h3>Quick Booking Request</h3>
					<p class="form-subtitle">Fill this form and we will confirm via WhatsApp within 30 minutes.</p>
					<div class="form-row">
						<div class="form-group">
							<label for="name">Full Name *</label>
							<input type="text" id="name" name="name" required placeholder="Your full name" />
						</div>
						<div class="form-group">
							<label for="phone">Phone / WhatsApp *</label>
							<input type="tel" id="phone" name="phone" required placeholder="+91 98765 43210" />
						</div>
					</div>
					<div class="form-row">
						<div class="form-group">
							<label for="checkin">Check-in Date *</label>
							<input type="date" id="checkin" name="checkin" required />
						</div>
						<div class="form-group">
							<label for="checkout">Check-out Date *</label>
							<input type="date" id="checkout" name="checkout" required />
						</div>
					</div>
					<div class="form-row">
						<div class="form-group">
							<label for="guests">Guests *</label>
							<select id="guests" name="guests" required>
								<option value="">Select</option>
								<option value="1">1</option>
								<option value="2">2</option>
								<option value="3">3</option>
								<option value="4">4</option>
								<option value="5">5+</option>
							</select>
						</div>
						<div class="form-group">
							<label for="room">Room Type</label>
							<select id="room" name="room">
								<option value="any">Any Available</option>
								<option value="ac-double">AC Double</option>
								<option value="ac-triple">AC Triple</option>
								<option value="ac-family">AC Family Suite</option>
								<option value="dormitory">Non-AC Dormitory</option>
							</select>
						</div>
					</div>
					<div class="form-group">
