---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';
const title = "Privacy Policy | Mahakal Bhakta Nivas";
const desc = "Privacy policy for Mahakal Bhakta Nivas dharmashala in Ujjain. Learn how we collect, use, and protect your personal information.";
---

<BaseLayout title={title} description={desc}>
  <Header />
  <main>
    <section class="page-hero">
      <div class="container">
        <nav aria-label="Breadcrumb" class="breadcrumb">
          <a href="/">Home</a> <span aria-hidden="true">›</span> <span>Privacy Policy</span>
        </nav>
        <h1>Privacy Policy</h1>
        <p>Effective Date: January 2025 | Last Updated: July 2026</p>
      </div>
    </section>
    <section class="privacy-content">
      <div class="container">
        <div class="privacy-body">
          <h2>1. Information We Collect</h2>
          <p>When you contact us via WhatsApp, phone, or email, we may collect your name, phone number, and booking details necessary to process your reservation.</p>
          <h2>2. How We Use Your Information</h2>
          <p>We use your information solely for processing bookings, communicating about your stay, and providing customer support. We do not sell or share your personal data with third parties.</p>
          <h2>3. WhatsApp Communication</h2>
          <p>By clicking our WhatsApp booking button, you initiate a conversation on WhatsApp. Your messages are handled per WhatsApp's privacy policy. We only use your number for booking-related communication.</p>
          <h2>4. Cookies & Website Analytics</h2>
          <p>Our website may use cookies for basic analytics and user experience. No personal data is collected through cookies without your consent.</p>
          <h2>5. Data Security</h2>
          <p>We implement reasonable security measures to protect your personal information. However, no method of transmission over the internet is 100% secure.</p>
          <h2>6. Your Rights</h2>
          <p>You can request to view, update, or delete your personal data by contacting us at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
          <h2>7. Contact Us</h2>
          <p>For privacy-related inquiries, please reach out to us at <a href={`mailto:${SITE.email}`}>{SITE.email}</a> or call <a href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a>.</p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page-hero { background: var(--c-cream); padding: 32px 0 28px; border-bottom: 1px solid rgba(0,0,0,0.05); }
  .breadcrumb { font-size: 13px; color: #888; margin-bottom: 14px; }
  .breadcrumb a { color: var(--c-maroon); }
  .page-hero h1 { font-family: var(--font-dev); font-size: clamp(1.5rem, 4vw, 2rem); color: var(--c-maroon); margin-bottom: 8px; }
  .page-hero p:last-child { font-size: 13px; color: #888; }
  .privacy-content { padding: 36px 0; }
  .privacy-body { max-width: 720px; }
  .privacy-body h2 { font-size: 1.1rem; color: var(--c-maroon); margin: 28px 0 10px; }
  .privacy-body h2:first-child { margin-top: 0; }
  .privacy-body p { font-size: 14.5px; color: #444; line-height: 1.7; margin-bottom: 14px; }
  .privacy-body a { color: var(--c-maroon); text-decoration: underline; }
</style>
