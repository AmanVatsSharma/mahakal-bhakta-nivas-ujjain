---
import { CONTACT, SITE } from '../config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>Page Not Found | {SITE.name} - Ujjain Dharmashala</title>
		<meta name="robots" content="noindex, follow" />
		<link rel="canonical" href={`${SITE.url}/`} />
		<script>
			setTimeout(() => {
				window.location.replace('/');
			}, 10);
		</script>
	</head>
	<body>
		<div class="not-found">
			<div class="not-found-content">
				<div class="om-symbol">🕉️</div>
				<h1>404</h1>
				<h2>Page Not Found</h2>
				<p>Apologies, the page you're looking for seems to have moved. Let us guide you back to the right path.</p>
				<div class="not-found-actions">
					<a href="/" class="btn btn-primary">Go Home</a>
					<a href="/rooms" class="btn btn-secondary">View Rooms</a>
					<a href={`https://wa.me/${CONTACT.whatsapp.replace(/\D/g, '')}`} class="btn btn-whatsapp" target="_blank" rel="noopener noreferrer">💬 Contact Us</a>
				</div>
			</div>
		</div>
	</body>
</html>

<style>
	.not-found {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, #fef9f3 0%, #fef5e6 100%);
		padding: 2rem;
	}

	.not-found-content {
		text-align: center;
		max-width: 520px;
	}

	.om-symbol {
		font-size: 4rem;
		margin-bottom: 1.5rem;
		animation: float 3s ease-in-out infinite;
	}

	@keyframes float {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-10px); }
	}

	.not-found h1 {
		font-size: 6rem;
		font-weight: 900;
		color: var(--color-primary, #ff9933);
		margin: 0;
		line-height: 1;
		letter-spacing: -2px;
	}

	.not-found h2 {
		font-size: 1.75rem;
		font-weight: 700;
		color: #2c2c2c;
		margin: 0.5rem 0 1rem;
	}

	.not-found p {
		font-size: 1.1rem;
		color: #666;
		line-height: 1.7;
		margin-bottom: 2rem;
	}

	.not-found-actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.85rem 1.75rem;
		border-radius: 50px;
		font-size: 1rem;
		font-weight: 600;
		text-decoration: none;
		cursor: pointer;
		transition: all 0.3s ease;
		border: none;
	}

	.btn-primary {
		background: var(--color-primary, #ff9933);
		color: white;
	}

	.btn-primary:hover {
		background: var(--color-primary-dark, #e88a2a);
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(255, 153, 51, 0.3);
	}

	.btn-secondary {
		background: #fff;
		color: #2c2c2c;
		border: 2px solid #ddd;
	}

	.btn-secondary:hover {
		border-color: #2c2c2c;
		transform: translateY(-2px);
	}

	.btn-whatsapp {
		background: #25D366;
		color: white;
	}

	.btn-whatsapp:hover {
		background: #1fb855;
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(37, 211, 102, 0.3);
	}
</style>
