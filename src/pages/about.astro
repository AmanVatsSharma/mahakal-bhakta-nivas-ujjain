---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="About Us - Mahakal Bhakta Nivas Ujjain"
  description="Learn about Mahakal Bhakta Nivas, our history of serving pilgrims at Mahakaleshwar Temple Ujjain, our values, and why we are the #1 choice for devotees visiting Ujjain."
>
  <Header />

  <section class="about-hero">
    <div class="about-hero-content">
      <span class="section-label" style="color:var(--color-gold-light)">Our Story</span>
      <h1 class="heading-display heading-xl" style="color:var(--color-white);margin-bottom:var(--space-6)">
        Serving Devotees for Over <em style="color:var(--color-gold)">25 Years</em>
      </h1>
      <p style="font-size:clamp(1rem,2vw,1.1875rem);color:rgba(255,255,255,0.75);line-height:1.8;max-width:700px;margin-inline:auto">
        Mahakal Bhakta Nivas was founded with a simple mission — to provide every devotee
        visiting the Mahakaleshwar Jyotirlinga with comfortable, affordable, and spiritually
        uplifting accommodation.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:800px">
      <div style="text-align:center;margin-bottom:var(--space-12)">
        <span class="section-label">Who We Are</span>
        <h2 class="heading-display heading-lg section-title">A Tradition of Hospitality</h2>
        <p style="color:var(--color-sand-700);font-size:1.0625rem;line-height:1.8">
          Founded in 1998 by the Agarwal family, Mahakal Bhakta Nivas started as a small
          10-room facility near the Mahakaleshwar Temple. Over the past 25+ years, we have
          grown into one of the most trusted dharmashalas in Ujjain, serving over
          <strong> 2,00,000 devotees</strong> from across India and the world.
        </p>
        <p style="color:var(--color-sand-700);font-size:1.0625rem;line-height:1.8;margin-top:var(--space-4)">
          Our philosophy is rooted in the tradition of <em>"Atithi Devo Bhava"</em> — the guest
          is divine. Every member of our team shares a deep connection to Ujjain and the
          Mahakaleshwar Temple, and we treat every visitor like family.
        </p>
      </div>

      <div class="values-grid">
        <div class="value-card">
          <div class="value-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z" />
            </svg>
          </div>
          <h3>Atithi Devo Bhava</h3>
          <p>We treat every guest as divine. Your comfort and spiritual experience is our highest priority.</p>
        </div>
        <div class="value-card">
          <div class="value-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
          </div>
          <h3>Trust & Safety</h3>
          <p>Secure premises, CCTV surveillance, and verified staff ensure your stay is worry-free.</p>
        </div>
        <div class="value-card">
          <div class="value-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 20A7 7 0 019.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z" />
              <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12" />
            </svg>
          </div>
          <h3>Pure & Sattvic</h3>
          <p>Our restaurant serves pure vegetarian, sattvic meals prepared with love and devotion.</p>
        </div>
        <div class="value-card">
          <div class="value-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2" />
              <circle cx="9" cy="7" r="4" />
              <path d="M23 21v-2a4 4 0 00-3-3.87" />
              <path d="M16 3.13a4 4 0 010 7.75" />
            </svg>
          </div>
          <h3>Community</h3>
          <p>We bring devotees together. Satsangs, group darshan arrangements, and shared experiences.</p>
        </div>
        <div class="value-card">
          <div class="value-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
          </div>
          <h3>Cleanliness</h3>
          <p>Hygiene is non-negotiable. Our rooms and common areas are cleaned daily to the highest standards.</p>
        </div>
        <div class="value-card">
          <div class="value-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10" />
              <line x1="2" y1="12" x2="22" y2="12" />
              <path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z" />
            </svg>
          </div>
          <h3>Accessibility</h3>
          <p>Located at the heart of the temple complex, we make darshan convenient for everyone.</p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
