---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
---

<BaseLayout title={`About Us | ${SITE.name}`} description={`Learn about Mahakal Bhakta Nivas — our story, mission, and commitment to providing the best accommodation near Mahakaleshwar Temple, Ujjain.`}>
	<div class="page-wrapper">
		<div class="container">
			<nav class="breadcrumb" aria-label="Breadcrumb">
				<a href="/">Home</a>
				<span>/</span>
				<span>About Us</span>
			</nav>
		</div>
	</div>

	<section class="page-hero">
		<div class="container">
			<h1>About Mahakal Bhakta Nivas</h1>
			<p class="lead">A tradition of warm hospitality for pilgrims visiting the sacred Mahakaleshwar Temple in Ujjain.</p>
		</div>
	</section>

	<section class="about-section">
		<div class="container">
			<div class="about-grid">
				<div>
					<h2>Our Story</h2>
					<p>Mahakal Bhakta Nivas was established with a singular vision: to provide clean, affordable, and peaceful accommodation for devotees visiting the Mahakaleshwar Jyotirlinga in Ujjain.</p>
					<p>For over 15 years, we have welcomed thousands of pilgrims from across India and abroad. Our family-run dharmashala is known for its cleanliness, warmth, and proximity to the temple — making it the preferred choice for devotees seeking a comfortable stay during their spiritual journey.</p>
				</div>
				<div>
					<h2>Our Mission</h2>
					<p>We believe that every pilgrim deserves a restful, hygienic, and spiritually uplifting place to stay — without breaking the bank.</p>
					<p>From solo travellers to large family groups, we offer a range of rooms and services to make your Ujjain visit memorable and hassle-free.</p>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.page-wrapper {
		padding: 1.5rem 0;
	}

	.breadcrumb {
		display: flex;
		gap: 0.5rem;
		align-items: center;
		font-size: 0.9rem;
		color: #8b6f47;
		padding: 1rem 0;
	}

	.breadcrumb a {
		color: #d97706;
		text-decoration: none;
	}

	.breadcrumb a:hover {
		text-decoration: underline;
	}

	.page-hero {
		background: linear-gradient(135deg, #fef9f3 0%, #fdf0d5 100%);
		padding: 3rem 1.5rem;
		text-align: center;
	}

	.page-hero h1 {
		font-family: 'Playfair Display', Georgia, serif;
		font-size: clamp(1.8rem, 5vw, 2.8rem);
		color: #1c1410;
		margin: 0 0 0.75rem;
	}

	.page-hero .lead {
		font-size: 1.1rem;
		color: #4b3c30;
		max-width: 650px;
		margin: 0 auto;
	}

	.about-section {
		padding: 4rem 1.5rem;
		background: white;
	}

	.about-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		max-width: 1000px;
		margin: 0 auto;
	}

	.about-grid h2 {
		font-family: 'Playfair Display', Georgia, serif;
		font-size: 1.6rem;
		color: #1c1410;
		margin: 0 0 1rem;
	}

	.about-grid p {
		font-size: 1rem;
		color: #4b3c30;
		line-height: 1.7;
		margin-bottom: 1rem;
	}

	@media (max-width: 640px) {
		.about-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}
</style>
