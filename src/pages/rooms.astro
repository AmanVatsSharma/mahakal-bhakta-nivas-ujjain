---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, CONTACT, ROOMS } from '../config';
const waNumber = SITE.whatsapp.replace(/\D/g, '');
const waLink = (text: string) => `https://wa.me/${waNumber}?text=${encodeURIComponent(text)}`;
const pageTitle = "Rooms Near Mahakaleshwar Temple ₹1,250–₹4,050 | Mahakal Bhakta Nivas Ujjain";
const pageDescription = "All 9 room types at Mahakal Bhakta Nivas — 2, 3 & 4 bed rooms (AC and Non-AC), Deluxe Room, Deluxe Suite and Luxury Suite from ₹1,250 to ₹4,050 per night, 200 m from Mahakaleshwar Temple. Attached bathrooms, hot water, pure veg food.";
const ROOM_FAQS = [
	{
		q: 'What is the cheapest room near Mahakaleshwar Temple?',
		a: 'Our 2 Bed Non-AC Room is ₹1,250 per night — two clean beds, attached bathroom and hot water, 200 m from the temple gate. For cool-season visits (October to February) it is the best value in the temple quarter.',
	},
	{
		q: 'Do you have AC rooms near Mahakaleshwar Temple?',
		a: 'Yes — six of our nine room types have air conditioning: 2 Bed AC (₹1,650), 3 Bed AC (₹2,050), 4 Bed AC (₹2,475), Deluxe Room (₹2,450), Deluxe Suite (₹3,150) and Luxury Suite (₹4,050). All AC rooms also have 24/7 power backup.',
	},
	{
		q: 'Which rooms suit a family of 4-6 near the temple?',
		a: 'Our 4 Bed Rooms (Non-AC ₹2,100, AC ₹2,475) comfortably sleep four, and larger families often combine a 3 Bed and a 2 Bed room next to each other. Every room has an attached bathroom — no shared facilities.',
	},
	{
		q: 'What are the check-in and check-out times?',
		a: 'Check-in is from 12:00 PM and check-out is by 11:00 AM. Early check-in or late check-out can often be arranged — message us on WhatsApp before your arrival and we will confirm.',
	},
	{
		q: 'Is food available at the dharamshala?',
		a: 'Yes, we serve pure vegetarian satvik meals with complimentary morning tea and prasadam. Tell the kitchen your dietary practice (no onion-garlic, Jain preparation) and it will do its best to accommodate.',
	},
	{
		q: 'Can I book a group block of rooms?',
		a: 'Yes — temple trusts, bhajan mandalis, weddings and yatra groups regularly block a mix of our 2, 3 and 4 bed rooms. Message us on WhatsApp with your dates and headcount for a combined quote.',
	},
];
---

<BaseLayout title={pageTitle} description={pageDescription} canonical="/rooms" breadcrumbs={[{ name: 'Rooms & Tariff', path: '/rooms' }]}>
    <main>
        <!-- Rooms Hero -->
        <section class="rooms-hero">
            <div class="container">
                <span class="section-tag">Accommodation</span>
                <h1>Rooms & Tariff</h1>
                <p class="hero-lead">Comfortable, clean, and affordable rooms for every budget — all within walking distance of Mahakaleshwar Temple.</p>
            </div>
        </section>

        <!-- Rooms Grid -->
        <section class="rooms-section">
            <div class="container">
                <div class="rooms-grid">
                    {ROOMS.map((room) => (
                        <div class:list={['room-card', room.badge === 'Best Seller' && 'featured']} itemscope itemtype="https://schema.org/LodgingBusiness">
                            <div class="room-image">
                                <img src={room.image} alt={room.imageAlt} loading="lazy" width="400" height="260" itemprop="image">
                                {room.badge && <span class:list={['room-type-badge', room.badge === 'Best Seller' && 'popular']}>{room.badge}</span>}
                            </div>
                            <div class="room-content">
                                <h3 itemprop="name">{room.name}</h3>
                                <p class="room-description">{room.description}</p>
                                <ul class="room-features">
                                    {room.features.map((feature) => (
                                        <li>✓ {feature}</li>
                                    ))}
                                </ul>
                                <div class="room-footer">
                                    <div class="room-price">
                                        <span class="price-amount" itemprop="priceRange">{room.priceText}</span>
                                        <span class="price-period">/night</span>
                                    </div>
                                    <a href={waLink(`Hello, I'd like to book the ${room.name} (${room.priceText}/night) at Mahakal Bhakta Nivas`)}
                                       class="btn btn-whatsapp btn-sm" target="_blank" rel="noopener">
                                        Book Now
                                    </a>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Room Guides: deep-dive links -->
        <section class="guides-band">
            <div class="container">
                <h2 class="section-title">Choosing Your Room: Our Detailed Guides</h2>
                <p class="section-intro">Not sure which room fits your trip? These guides break down every option by budget, family size and season.</p>
                <div class="guides-links">
                    <a href="/blog/where-to-stay-near-mahakaleshwar-temple/">Where to Stay Near Mahakaleshwar Temple</a>
                    <a href="/blog/ac-rooms-near-mahakaleshwar-temple/">AC Rooms Near the Temple</a>
                    <a href="/blog/family-rooms-near-mahakaleshwar-temple/">Family Rooms (3 &amp; 4 Bed) Guide</a>
                    <a href="/blog/rooms-near-mahakaleshwar-under-2500/">Rooms Under ₹2,500 Ranked</a>
                    <a href="/blog/luxury-room-near-mahakaleshwar/">Luxury Suites Explained</a>
                    <a href="/blog/group-booking-ujjain-dharamshala/">Group Bookings for 10-50 Devotees</a>
                    <a href="/blog/non-ac-rooms-near-mahakaleshwar/">Non-AC Rooms: The Winter Value Pick</a>
                    <a href="/blog/dharamshala-vs-hotel-ujjain/">Dharamshala vs Hotel in Ujjain</a>
                </div>
            </div>
        </section>

        <!-- Rooms FAQ -->
        <section class="faq-band">
            <div class="container">
                <h2 class="section-title">Rooms &amp; Tariff FAQs</h2>
                <div class="faq-list">
                    {ROOM_FAQS.map((faq) => (
                        <details class="faq-item">
                            <summary>{faq.q}</summary>
                            <p>{faq.a}</p>
                        </details>
                    ))}
                </div>
            </div>
        </section>

        <!-- Amenities Band -->
        <section class="amenities-section">
            <div class="container">
                <h2 class="section-title">All Rooms Include</h2>
                <div class="amenities-grid">
                    <div class="amenity-item">
                        <span class="amenity-icon">🛏️</span>
                        <span>Clean Linen</span>
                    </div>
                    <div class="amenity-item">
                        <span class="amenity-icon">🚿</span>
                        <span>Hot Water</span>
                    </div>
                    <div class="amenity-item">
                        <span class="amenity-icon">📶</span>
                        <span>Free WiFi</span>
                    </div>
                    <div class="amenity-item">
                        <span class="amenity-icon">📺</span>
                        <span>Television</span>
                    </div>
                    <div class="amenity-item">
                        <span class="amenity-icon">❄️</span>
                        <span>AC Rooms & Suites</span>
                    </div>
                    <div class="amenity-item">
                        <span class="amenity-icon">🔒</span>
                        <span>24x7 Security</span>
                    </div>
                    <div class="amenity-item">
                        <span class="amenity-icon">🔌</span>
                        <span>Power Backup</span>
                    </div>
                    <div class="amenity-item">
                        <span class="amenity-icon">🛎️</span>
                        <span>Room Service</span>
                    </div>
                    <div class="amenity-item">
                        <span class="amenity-icon">🥗</span>
                        <span>Pure Veg Food</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Terms -->
        <section class="terms-section">
            <div class="container">
                <h2 class="section-title">Booking Information</h2>
                <div class="terms-grid">
                    <div class="term-item">
                        <h3>🕐 Check-in / Check-out</h3>
                        <p>Check-in from 12:00 PM, Check-out by 11:00 AM. Early check-in/late check-out subject to availability.</p>
                    </div>
                    <div class="term-item">
                        <h3>📋 ID Required</h3>
                        <p>Government-issued photo ID (Aadhaar, PAN, Passport, or Driving License) is mandatory at check-in.</p>
                    </div>
                    <div class="term-item">
                        <h3>💳 Payment</h3>
                        <p>Cash and UPI payments accepted. Advance booking recommended during Simhastha Kumbh Mela and Mahashivratri.</p>
                    </div>
                    <div class="term-item">
                        <h3>🍽️ Food</h3>
                        <p>Pure vegetarian meals available. Thali meals, snacks, and prasadam can be arranged. Ask at reception.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA -->
        <section class="cta-section">
            <div class="container">
                <div class="cta-card">
                    <h2>Book Your Stay Today</h2>
                    <p>Call or WhatsApp us to check availability and book your room at Mahakal Bhakta Nivas.</p>
                    <div class="cta-buttons">
                        <a href={waLink("Hello, I'd like to book a room at Mahakal Bhakta Nivas")}
                           class="btn btn-whatsapp" target="_blank" rel="noopener">
                            Book on WhatsApp
                        </a>
                        <a href={`tel:${CONTACT.phone}`} class="btn btn-call">
                            Call Now
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- FAQPage Schema -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": ROOM_FAQS.map((f) => ({
            "@type": "Question",
            "name": f.q,
            "acceptedAnswer": { "@type": "Answer", "text": f.a }
        }))
    })} />
</BaseLayout>

<style>
    /* Room guides band */
    .guides-band {
        padding: var(--space-12) 0;
        background: var(--cream);
    }

    .guides-links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3);
        justify-content: center;
        max-width: 900px;
        margin: var(--space-6) auto 0;
    }

    .guides-links a {
        background: white;
        border: 1px solid var(--gray-100, rgba(0,0,0,0.08));
        color: var(--primary-900, #1c1410);
        padding: var(--space-3) var(--space-4);
        border-radius: var(--radius-full);
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.25s ease;
    }

    .guides-links a:hover {
        background: var(--primary-900, #1c1410);
        color: var(--cream, #fdf9f3);
    }

    /* Rooms FAQ band */
    .faq-band {
        padding: var(--space-12) 0;
        background: white;
    }

    .faq-list {
        max-width: 760px;
        margin: var(--space-8) auto 0;
        display: grid;
        gap: var(--space-3);
    }

    .faq-item {
        background: var(--cream, #fdf9f3);
        border-radius: var(--radius-lg, 12px);
        padding: var(--space-4) var(--space-5);
        border: 1px solid rgba(0,0,0,0.06);
    }

    .faq-item summary {
        font-weight: 600;
        color: var(--primary-900, #1c1410);
        cursor: pointer;
        font-size: 0.95rem;
        list-style: none;
        position: relative;
        padding-right: 1.5rem;
    }

    .faq-item summary::-webkit-details-marker {
        display: none;
    }

    .faq-item summary::after {
        content: "+";
        position: absolute;
        right: 0;
        top: 0;
        color: var(--primary-700, #8b6f47);
        font-size: 1.2rem;
        line-height: 1;
    }

    .faq-item[open] summary::after {
        content: "−";
    }

    .faq-item p {
        margin: var(--space-3) 0 0;
        color: var(--gray-600, #555);
        font-size: 0.9rem;
        line-height: 1.65;
    }

    .rooms-hero {
        padding: var(--space-16) 0;
        background: linear-gradient(135deg, var(--primary-900) 0%, var(--primary-800) 100%);
        text-align: center;
    }

    .rooms-hero .section-tag {
        display: inline-block;
        background: var(--accent);
        color: var(--cream);
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-full);
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: var(--space-4);
    }

    .rooms-hero h1 {
        font-size: clamp(2rem, 5vw, 3rem);
        color: var(--cream);
        margin-bottom: var(--space-4);
    }

    .rooms-hero .hero-lead {
        color: var(--primary-200);
        font-size: 1.1rem;
        max-width: 600px;
        margin: 0 auto;
    }

    .rooms-section {
        padding: var(--space-16) 0;
        background: var(--cream);
    }

    .rooms-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-6);
        margin-top: var(--space-10);
    }

    .room-card {
        background: white;
        border-radius: var(--radius-xl);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: 2px solid transparent;
    }

    .room-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-lg);
    }

    .room-card.featured {
        border-color: var(--accent);
    }

    .room-image {
        position: relative;
        height: 220px;
        overflow: hidden;
    }

    .room-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .room-type-badge {
        position: absolute;
        top: var(--space-4);
        left: var(--space-4);
        background: var(--primary-900);
        color: var(--cream);
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-full);
        font-size: 0.8rem;
        font-weight: 600;
    }

    .room-type-badge.popular {
        background: var(--accent);
    }

    .room-content {
        padding: var(--space-6);
    }

    .room-content h3 {
        font-size: 1.3rem;
        color: var(--primary-900);
        margin-bottom: var(--space-3);
    }

    .room-description {
        color: var(--gray-600);
        font-size: 0.95rem;
        margin-bottom: var(--space-4);
        line-height: 1.6;
    }

    .room-features {
        list-style: none;
        padding: 0;
        margin: 0 0 var(--space-4);
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-2);
    }

    .room-features li {
        font-size: 0.85rem;
        color: var(--gray-700);
    }

    .room-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: var(--space-4);
        border-top: 1px solid var(--gray-100);
    }

    .room-price {
        display: flex;
        align-items: baseline;
        gap: var(--space-1);
    }

    .price-amount {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--primary-700);
    }

    .price-period {
        font-size: 0.85rem;
        color: var(--gray-500);
    }

    .btn-sm {
        padding: var(--space-2) var(--space-5);
        font-size: 0.85rem;
    }

    /* Amenities */
    .amenities-section {
        padding: var(--space-16) 0;
        background: white;
    }

    .amenities-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-6);
        margin-top: var(--space-10);
        max-width: 800px;
        margin-left: auto;
        margin-right: auto;
    }

    .amenity-item {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        padding: var(--space-4);
        background: var(--gray-50);
        border-radius: var(--radius-lg);
        transition: background 0.3s ease;
    }

    .amenity-item:hover {
        background: var(--primary-50);
    }

    .amenity-icon {
        font-size: 1.5rem;
    }

    .amenity-item span:last-child {
        font-weight: 500;
        color: var(--gray-700);
        font-size: 0.9rem;
    }

    /* Terms */
    .terms-section {
        padding: var(--space-16) 0;
        background: linear-gradient(135deg, var(--primary-50) 0%, var(--cream) 100%);
    }

    .terms-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-4);
        margin-top: var(--space-10);
    }

    .term-item {
        background: white;
        padding: var(--space-6);
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow-sm);
    }

    .term-item h3 {
        font-size: 1rem;
        color: var(--primary-900);
        margin-bottom: var(--space-2);
    }

    .term-item p {
        color: var(--gray-600);
        font-size: 0.9rem;
        line-height: 1.6;
        margin: 0;
    }

    /* CTA */
    .cta-section {
        padding: var(--space-16) 0;
        background: var(--primary-900);
    }

    .cta-card {
        text-align: center;
        max-width: 600px;
        margin: 0 auto;
    }

    .cta-card h2 {
        font-size: clamp(1.6rem, 4vw, 2.2rem);
        color: var(--cream);
        margin-bottom: var(--space-4);
    }

    .cta-card p {
        color: var(--primary-200);
        font-size: 1.05rem;
        margin-bottom: var(--space-8);
    }

    .cta-buttons {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        align-items: center;
    }

    .cta-buttons .btn {
        width: 100%;
        max-width: 320px;
        justify-content: center;
    }

    @media (min-width: 768px) {
        .rooms-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .amenities-grid {
            grid-template-columns: repeat(3, 1fr);
        }

        .terms-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .cta-buttons {
            flex-direction: row;
            justify-content: center;
        }

        .cta-buttons .btn {
            width: auto;
            min-width: 220px;
        }
    }

    @media (min-width: 1024px) {
        .rooms-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>
