---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, CONTACT, ROOMS } from '../config';
const waNumber = SITE.whatsapp.replace(/\D/g, '');
const waLink = (text: string) => `https://wa.me/${waNumber}?text=${encodeURIComponent(text)}`;
const pageTitle = "Rooms & Accommodation - Mahakal Bhakta Nivas | Budget to Luxury Rooms in Ujjain";
const pageDescription = "View our 9 room types at Mahakal Bhakta Nivas Ujjain — from the 2 Bed Non-AC Room (₹1,250) to the Luxury Suite (₹4,050). All rooms near Mahakaleshwar Temple with attached bathrooms, hot water, and pure veg food.";
---

<BaseLayout title={pageTitle} description={pageDescription} canonical="/rooms">
    <main>
        <!-- Rooms Hero -->
        <section class="rooms-hero">
            <div class="container">
                <span class="section-tag">Accommodation</span>
                <h1>Rooms & Tariff</h1>
                <p class="hero-lead">Comfortable, clean, and affordable rooms for every budget — all within walking distance of Mahakaleshwar Temple.</p>
            </div>
        </section>

        <!-- Rooms Grid -->
        <section class="rooms-section">
            <div class="container">
                <div class="rooms-grid">
                    {ROOMS.map((room) => (
                        <div class:list={['room-card', room.badge === 'Best Seller' && 'featured']} itemscope itemtype="https://schema.org/LodgingBusiness">
                            <div class="room-image">
                                <img src={room.image} alt={room.imageAlt} loading="lazy" width="400" height="260" itemprop="image">
                                {room.badge && <span class:list={['room-type-badge', room.badge === 'Best Seller' && 'popular']}>{room.badge}</span>}
                            </div>
                            <div class="room-content">
                                <h3 itemprop="name">{room.name}</h3>
                                <p class="room-description">{room.description}</p>
                                <ul class="room-features">
                                    {room.features.map((feature) => (
                                        <li>✓ {feature}</li>
                                    ))}
                                </ul>
                                <div class="room-footer">
                                    <div class="room-price">
                                        <span class="price-amount" itemprop="priceRange">{room.priceText}</span>
                                        <span class="price-period">/night</span>
                                    </div>
                                    <a href={waLink(`Hello, I'd like to book the ${room.name} (${room.priceText}/night) at Mahakal Bhakta Nivas`)}
                                       class="btn btn-whatsapp btn-sm" target="_blank" rel="noopener">
                                        Book Now
                                    </a>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <!-- Amenities Band -->
        <section class="amenities-section">
            <div class="container">
                <h2 class="section-title">All Rooms Include</h2>
                <div class="amenities-grid">
                    <div class="amenity-item">
                        <span class="amenity-icon">🛏️</span>
                        <span>Clean Linen</span>
                    </div>
                    <div class="amenity-item">
                        <span class="amenity-icon">🚿</span>
                        <span>Hot Water</span>
                    </div>
                    <div class="amenity-item">
                        <span class="amenity-icon">📶</span>
                        <span>Free WiFi</span>
                    </div>
                    <div class="amenity-item">
                        <span class="amenity-icon">📺</span>
                        <span>Television</span>
                    </div>
                    <div class="amenity-item">
                        <span class="amenity-icon">❄️</span>
                        <span>AC Rooms & Suites</span>
                    </div>
                    <div class="amenity-item">
                        <span class="amenity-icon">🔒</span>
                        <span>24x7 Security</span>
                    </div>
                    <div class="amenity-item">
                        <span class="amenity-icon">🔌</span>
                        <span>Power Backup</span>
                    </div>
                    <div class="amenity-item">
                        <span class="amenity-icon">🛎️</span>
                        <span>Room Service</span>
                    </div>
                    <div class="amenity-item">
                        <span class="amenity-icon">🥗</span>
                        <span>Pure Veg Food</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Terms -->
        <section class="terms-section">
            <div class="container">
                <h2 class="section-title">Booking Information</h2>
                <div class="terms-grid">
                    <div class="term-item">
                        <h3>🕐 Check-in / Check-out</h3>
                        <p>Check-in from 12:00 PM, Check-out by 11:00 AM. Early check-in/late check-out subject to availability.</p>
                    </div>
                    <div class="term-item">
                        <h3>📋 ID Required</h3>
                        <p>Government-issued photo ID (Aadhaar, PAN, Passport, or Driving License) is mandatory at check-in.</p>
                    </div>
                    <div class="term-item">
                        <h3>💳 Payment</h3>
                        <p>Cash and UPI payments accepted. Advance booking recommended during Simhastha Kumbh Mela and Mahashivratri.</p>
                    </div>
                    <div class="term-item">
                        <h3>🍽️ Food</h3>
                        <p>Pure vegetarian meals available. Thali meals, snacks, and prasadam can be arranged. Ask at reception.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA -->
        <section class="cta-section">
            <div class="container">
                <div class="cta-card">
                    <h2>Book Your Stay Today</h2>
                    <p>Call or WhatsApp us to check availability and book your room at Mahakal Bhakta Nivas.</p>
                    <div class="cta-buttons">
                        <a href={waLink("Hello, I'd like to book a room at Mahakal Bhakta Nivas")}
                           class="btn btn-whatsapp" target="_blank" rel="noopener">
                            Book on WhatsApp
                        </a>
                        <a href={`tel:${CONTACT.phone}`} class="btn btn-call">
                            Call Now
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>

<style>
    .rooms-hero {
        padding: var(--space-16) 0;
        background: linear-gradient(135deg, var(--primary-900) 0%, var(--primary-800) 100%);
        text-align: center;
    }

    .rooms-hero .section-tag {
        display: inline-block;
        background: var(--accent);
        color: var(--cream);
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-full);
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: var(--space-4);
    }

    .rooms-hero h1 {
        font-size: clamp(2rem, 5vw, 3rem);
        color: var(--cream);
        margin-bottom: var(--space-4);
    }

    .rooms-hero .hero-lead {
        color: var(--primary-200);
        font-size: 1.1rem;
        max-width: 600px;
        margin: 0 auto;
    }

    .rooms-section {
        padding: var(--space-16) 0;
        background: var(--cream);
    }

    .rooms-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-6);
        margin-top: var(--space-10);
    }

    .room-card {
        background: white;
        border-radius: var(--radius-xl);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: 2px solid transparent;
    }

    .room-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-lg);
    }

    .room-card.featured {
        border-color: var(--accent);
    }

    .room-image {
        position: relative;
        height: 220px;
        overflow: hidden;
    }

    .room-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .room-type-badge {
        position: absolute;
        top: var(--space-4);
        left: var(--space-4);
        background: var(--primary-900);
        color: var(--cream);
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-full);
        font-size: 0.8rem;
        font-weight: 600;
    }

    .room-type-badge.popular {
        background: var(--accent);
    }

    .room-content {
        padding: var(--space-6);
    }

    .room-content h3 {
        font-size: 1.3rem;
        color: var(--primary-900);
        margin-bottom: var(--space-3);
    }

    .room-description {
        color: var(--gray-600);
        font-size: 0.95rem;
        margin-bottom: var(--space-4);
        line-height: 1.6;
    }

    .room-features {
        list-style: none;
        padding: 0;
        margin: 0 0 var(--space-4);
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-2);
    }

    .room-features li {
        font-size: 0.85rem;
        color: var(--gray-700);
    }

    .room-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: var(--space-4);
        border-top: 1px solid var(--gray-100);
    }

    .room-price {
        display: flex;
        align-items: baseline;
        gap: var(--space-1);
    }

    .price-amount {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--primary-700);
    }

    .price-period {
        font-size: 0.85rem;
        color: var(--gray-500);
    }

    .btn-sm {
        padding: var(--space-2) var(--space-5);
        font-size: 0.85rem;
    }

    /* Amenities */
    .amenities-section {
        padding: var(--space-16) 0;
        background: white;
    }

    .amenities-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-6);
        margin-top: var(--space-10);
        max-width: 800px;
        margin-left: auto;
        margin-right: auto;
    }

    .amenity-item {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        padding: var(--space-4);
        background: var(--gray-50);
        border-radius: var(--radius-lg);
        transition: background 0.3s ease;
    }

    .amenity-item:hover {
        background: var(--primary-50);
    }

    .amenity-icon {
        font-size: 1.5rem;
    }

    .amenity-item span:last-child {
        font-weight: 500;
        color: var(--gray-700);
        font-size: 0.9rem;
    }

    /* Terms */
    .terms-section {
        padding: var(--space-16) 0;
        background: linear-gradient(135deg, var(--primary-50) 0%, var(--cream) 100%);
    }

    .terms-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-4);
        margin-top: var(--space-10);
    }

    .term-item {
        background: white;
        padding: var(--space-6);
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow-sm);
    }

    .term-item h3 {
        font-size: 1rem;
        color: var(--primary-900);
        margin-bottom: var(--space-2);
    }

    .term-item p {
        color: var(--gray-600);
        font-size: 0.9rem;
        line-height: 1.6;
        margin: 0;
    }

    /* CTA */
    .cta-section {
        padding: var(--space-16) 0;
        background: var(--primary-900);
    }

    .cta-card {
        text-align: center;
        max-width: 600px;
        margin: 0 auto;
    }

    .cta-card h2 {
        font-size: clamp(1.6rem, 4vw, 2.2rem);
        color: var(--cream);
        margin-bottom: var(--space-4);
    }

    .cta-card p {
        color: var(--primary-200);
        font-size: 1.05rem;
        margin-bottom: var(--space-8);
    }

    .cta-buttons {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        align-items: center;
    }

    .cta-buttons .btn {
        width: 100%;
        max-width: 320px;
        justify-content: center;
    }

    @media (min-width: 768px) {
        .rooms-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .amenities-grid {
            grid-template-columns: repeat(3, 1fr);
        }

        .terms-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .cta-buttons {
            flex-direction: row;
            justify-content: center;
        }

        .cta-buttons .btn {
            width: auto;
            min-width: 220px;
        }
    }

    @media (min-width: 1024px) {
        .rooms-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>
