---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const rooms = [
  {
    title: 'Deluxe Room',
    desc: 'Comfortable AC room with queen bed, attached bathroom with hot water, and temple view.',
    price: '₹1,200',
    capacity: '2 Guests',
    size: '200 sq ft',
    features: ['AC', 'Hot Water', 'Free WiFi', 'TV', 'Temple View'],
    image: 'https://images.unsplash.com/photo-1590490360182-c33d57733427?w=600&h=400&fit=crop',
  },
  {
    title: 'Family Suite',
    desc: 'Spacious room with double bed + single bed, perfect for families visiting the temple.',
    price: '₹1,800',
    capacity: '4 Guests',
    size: '320 sq ft',
    features: ['AC', 'Hot Water', 'Free WiFi', 'Balcony', 'Mini Fridge'],
    image: 'https://images.unsplash.com/photo-1566665797739-1674de7a421a?w=600&h=400&fit=crop',
  },
  {
    title: 'Temple View Room',
    desc: 'Premium room with direct view of Mahakaleshwar Temple gopuram. Wake up to darshan vibes.',
    price: '₹2,500',
    capacity: '2 Guests',
    size: '240 sq ft',
    features: ['AC', 'Hot Water', 'Free WiFi', 'TV', 'Balcony', 'Temple View'],
    image: 'https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?w=600&h=400&fit=crop',
  },
  {
    title: 'Non-AC Room',
    desc: 'Clean, well-ventilated budget room with comfortable beds. Great for pilgrims on a budget.',
    price: '₹600',
    capacity: '2 Guests',
    size: '150 sq ft',
    features: ['Fan', 'Hot Water', 'Common WiFi'],
    image: 'https://images.unsplash.com/photo-1522771739844-6a9f6d5f14af?w=600&h=400&fit=crop',
  },
  {
    title: 'Dormitory',
    desc: 'Shared accommodation for large groups. Separate spaces for men and women with lockers.',
    price: '₹350',
    capacity: '6-8 Guests',
    size: 'Shared Hall',
    features: ['Fan', 'Hot Water', 'Common WiFi', 'Lockers'],
    image: 'https://images.unsplash.com/photo-1555854877-bab0e1dbfd81?w=600&h=400&fit=crop',
  },
  {
    title: 'Dharamshala Hall',
    desc: 'Large hall for group bookings and satsangs. Mattress arrangement for 50+ people.',
    price: '₹200/bed',
    capacity: '50+ Guests',
    size: 'Large Hall',
    features: ['Common Bath', 'Hot Water', 'Kitchen Access', 'Power Backup'],
    image: 'https://images.unsplash.com/photo-1497366216548-37526070297c?w=600&h=400&fit=crop',
  },
];

const checkSvg = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>`;
---

<BaseLayout
  title="Rooms & Rates - Mahakal Bhakta Nivas Ujjain"
  description="View our rooms at Mahakal Bhakta Nivas. Deluxe rooms, family suites, temple view rooms, dormitory and budget rooms near Mahakaleshwar Temple, Ujjain. Prices starting from ₹350."
>
  <Header />

  <section class="section" style="padding-top:100px">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Our Accommodation</span>
        <h1 class="heading-display heading-lg section-title">Rooms & Rates</h1>
        <p class="section-subtitle">
          From budget dormitories to premium temple-view suites — we have the perfect stay for every pilgrim.
        </p>
      </div>

      <div class="rooms-grid stagger-children">
        {rooms.map((room) => (
          <div class="room-card">
            <div class="room-card-image">
              <img src={room.image} alt={room.title} loading="lazy" />
              <span class="room-badge">From {room.price}/night</span>
            </div>
            <div class="room-card-body">
              <h3 class="room-card-title">{room.title}</h3>
              <p class="room-card-desc">{room.desc}</p>
              <div style="display:flex;gap:var(--space-4);font-size:0.8125rem;color:var(--color-sand-700);margin-bottom:var(--space-3)">
                <span>👥 {room.capacity}</span>
                <span>📐 {room.size}</span>
              </div>
              <div class="room-features" style="margin-bottom:var(--space-4)">
                {room.features.map(f => (
                  <span class="room-feature">
                    <span set:html={checkSvg} />
                    {f}
                  </span>
                ))}
              </div>
              <a href={"https://wa.me/919876543210?text=" + encodeURIComponent("Hi, I would like to inquire about " + room.title)} class="btn btn-primary" target="_blank" rel="noopener">
                Book {room.title}
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />

  <div class="floating-cta">
    <a href="https://wa.me/919876543210" class="btn btn-whatsapp" target="_blank" rel="noopener">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      WhatsApp
    </a>
    <a href="tel:+919876543210" class="btn btn-call">Call</a>
  </div>

  <script>
    const header = document.getElementById('siteHeader');
    window.addEventListener('scroll', () => {
      header.classList.toggle('scrolled', window.scrollY > 50);
    }, { passive: true });

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => { if (entry.isIntersecting) entry.target.classList.add('visible'); });
    }, { threshold: 0.1 });
    document.querySelectorAll('.animate-on-scroll').forEach(el => observer.observe(el));
  </script>
</BaseLayout>
